# Atlasia web/PWA — istemci tarafında gereken Firebase web yapılandırması.
# Gerçek değerleri yalnız Cloudflare ortam değişkenlerinde veya .env.local içinde tut.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Atlasia'yı yayında denetlemek için (isteğe bağlı, istemciye gitmez):
#   npm run dogrula:canli
# Cloudflare Production ortamında beklenen Firebase projesinin beyanı. Kapı,
# VITE_FIREBASE_PROJECT_ID bu değerle uyuşmazsa uyarır. VITE_ öneki YOKTUR,
# bu yüzden istemci paketine girmez. Örnek: atlasia-dev
ATLASIA_URETIM_PROJESI=
# Üretim env politika ihlallerini ölümcül yapmak için "enforce" (varsayılan: warn).
ATLASIA_PROD_ENV_POLICY=

# İsteğe bağlı: yerel Vite sunucusuna erişebilecek ek hostlar, virgülle ayrılır.
# Protokol, port veya joker (*) yazma. Örnek: preview.example.com,.e2b.app
ATLASIA_ALLOWED_HOSTS=

# İsteğe bağlı: varsayılan https://photon.komoot.io
VITE_GEOCODER_URL=

# İsteğe bağlı: yalnız yerel geliştirme için kayıtlı App Check debug token'ı.
# Firebase konsolunda App Check → Apps → ⋯ → Manage debug tokens ile üretilir.
# App Check doğrulamasını atlatan hassas bir değerdir; yalnız .env.local'de tut,
# ASLA commit etme veya üretim ortamına koyma.
VITE_APPCHECK_DEBUG_TOKEN=

# İsteğe bağlı özellik bayrağı. Apple sağlayıcısı yapılandırılmadan true yapma.
VITE_APPLE_AUTH_ENABLED=

# İsteğe bağlı özellik bayrağı. Phone sağlayıcısı Firebase Console'da etkinleştirilmeden true yapma (varsayılan kapalı).
VITE_PHONE_AUTH_ENABLED=

# İsteğe bağlı Street Peek gömüsü. Anahtarı HTTP referrer ve API kısıtlarıyla sınırla.
VITE_GOOGLE_MAPS_EMBED_KEY=
