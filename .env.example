# Atlasia web/PWA — istemci tarafında gereken Firebase web yapılandırması.
# Gerçek değerleri yalnız Cloudflare ortam değişkenlerinde veya .env.local içinde tut.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# İsteğe bağlı public reCAPTCHA Enterprise site key; varsayılan Atlasia anahtarı kullanılır.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# İsteğe bağlı: yerel Vite sunucusuna erişebilecek ek hostlar, virgülle ayrılır.
# Protokol, port veya joker (*) yazma. Örnek: preview.example.com,.e2b.app
ATLASIA_ALLOWED_HOSTS=

# İsteğe bağlı: varsayılan https://photon.komoot.io
VITE_GEOCODER_URL=

# İsteğe bağlı özellik bayrağı. Apple sağlayıcısı yapılandırılmadan true yapma.
VITE_APPLE_AUTH_ENABLED=false

# İsteğe bağlı Street Peek gömüsü. Anahtarı HTTP referrer ve API kısıtlarıyla sınırla.
VITE_GOOGLE_MAPS_EMBED_KEY=
