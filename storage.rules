rules_version = '2';

// Atlasia — Firebase Storage güvenlik kuralları
// Firebase Console > Storage > Rules sekmesine yapıştır.

service firebase.storage {
  match /b/{bucket}/o {

    // Yer fotoğrafları: giriş yapmış kullanıcı yazabilir, herkes okuyabilir.
    match /places/{placeId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // 5 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Post fotoğrafları
    match /posts/{postId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Story fotoğrafları
    match /stories/{storyId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Diğer her şey yasak
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
