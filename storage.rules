rules_version = '2';

// Atlasia fotoğrafları Firebase Storage kullanmaz; istemcide sınırlandırılıp
// ilgili Firestore dokümanına kaydedilir. Yanlışlıkla bir bucket açılırsa
// burada açık bir yazma yüzeyi kalmaması için bütün erişim kapalıdır.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
