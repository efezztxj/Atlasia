rules_version = '2';

// Atlasia — Firestore güvenlik kuralları
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function boundedList(maxItems) {
      return request.query.limit != null && request.query.limit <= maxItems;
    }

    function stringBetween(value, minSize, maxSize) {
      return value is string
             && value.size() >= minSize
             && value.size() <= maxSize;
    }

    function hasValidPhoto(data) {
      return ('photo' in data)
             && data.photo is string
             && data.photo.size() <= 180000
             && data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }

    function hasValidOptionalPhoto(data) {
      return !('photo' in data) || hasValidPhoto(data);
    }

    function hasTextOrPhoto(data, maxTextSize) {
      return data.text is string
             && data.text.size() <= maxTextSize
             && (data.text.size() > 0 || hasValidPhoto(data));
    }

    function hasValidOptionalLocation(data) {
      return (
        !('lng' in data)
        && !('lat' in data)
      ) || (
        ('lng' in data)
        && ('lat' in data)
        && data.lng is number
        && data.lng >= -180
        && data.lng <= 180
        && data.lat is number
        && data.lat >= -90
        && data.lat <= 90
      );
    }

    function validPlaceShape(data) {
      return data.keys().hasAll([
               'title', 'region', 'category', 'lng', 'lat', 'note',
               'author', 'authorUid', 'kind', 'createdAt'
             ])
             && data.keys().hasOnly([
               'title', 'region', 'category', 'lng', 'lat', 'note',
               'author', 'authorUid', 'kind', 'createdAt', 'photo'
             ])
             && stringBetween(data.title, 1, 200)
             && stringBetween(data.region, 0, 200)
             && data.category in [
               'cities', 'beaches', 'history', 'nature', 'camp', 'food',
               'photo', 'routes', 'community', 'issues'
             ]
             && data.lng is number
             && data.lng >= -180
             && data.lng <= 180
             && data.lat is number
             && data.lat >= -90
             && data.lat <= 90
             && stringBetween(data.note, 0, 5000)
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && data.kind == 'user'
             && data.createdAt is timestamp
             && hasValidOptionalPhoto(data);
    }

    function validPostShape(data) {
      return data.keys().hasAll([
               'author', 'authorUid', 'text', 'createdAt', 'likes',
               'likedBy', 'kind'
             ])
             && data.keys().hasOnly([
               'author', 'authorUid', 'text', 'createdAt', 'likes',
               'likedBy', 'kind', 'placeLabel', 'lng', 'lat', 'photo'
             ])
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && hasTextOrPhoto(data, 5000)
             && data.createdAt is timestamp
             && data.likes is int
             && data.likes >= 0
             && data.likedBy is list
             && data.likedBy.size() <= 500
             && data.likedBy.toSet().size() == data.likedBy.size()
             && data.kind == 'user'
             && (!('placeLabel' in data) || stringBetween(data.placeLabel, 1, 200))
             && hasValidOptionalLocation(data)
             && hasValidOptionalPhoto(data);
    }

    function validLikeToggle() {
      let before = resource.data.likedBy;
      let after = request.resource.data.likedBy;
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());
      return before is list
             && after is list
             && after.size() <= 500
             && after.toSet().size() == after.size()
             && (
               (
                 after.size() == before.size() + 1
                 && added.size() == 1
                 && added.hasOnly([request.auth.uid])
                 && removed.size() == 0
               ) || (
                 after.size() == before.size() - 1
                 && removed.size() == 1
                 && removed.hasOnly([request.auth.uid])
                 && added.size() == 0
               )
             );
    }

    function validReplyShape(data) {
      return data.keys().hasAll([
               'author', 'authorUid', 'text', 'createdAt', 'kind'
             ])
             && data.keys().hasOnly([
               'author', 'authorUid', 'text', 'createdAt', 'kind'
             ])
             && stringBetween(data.author, 1, 100)
             && data.authorUid == request.auth.uid
             && stringBetween(data.text, 1, 1000)
             && data.createdAt == request.time
             && data.kind == 'user';
    }

    function validPostInteraction() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() == 0 || (
        changed.size() == 1
        && changed.hasOnly(['likedBy'])
        && validLikeToggle()
      );
    }

    function validRouteBody(route) {
      return route is map
             && route.keys().hasAll([
               'id', 'routeTitle', 'routeSummary', 'totalDurationHours',
               'totalDistanceKm', 'transport', 'vibe', 'days', 'weatherNote',
               'alternatives', 'createdAt'
             ])
             && route.keys().hasOnly([
               'id', 'routeTitle', 'routeSummary', 'totalDurationHours',
               'totalDistanceKm', 'transport', 'vibe', 'days', 'weatherNote',
               'alternatives', 'dataSources', 'createdAt', 'origin', 'photo', 'region'
             ])
             && stringBetween(route.id, 1, 128)
             && stringBetween(route.routeTitle, 1, 160)
             && stringBetween(route.routeSummary, 0, 5000)
             && route.totalDurationHours is number
             && route.totalDurationHours >= 0
             && route.totalDurationHours <= 1000
             && route.totalDistanceKm is number
             && route.totalDistanceKm >= 0
             && route.totalDistanceKm <= 100000
             && route.transport in ['walking', 'cycling', 'driving', 'transit']
             && stringBetween(route.vibe, 0, 200)
             && route.days is list
             && route.days.size() <= 30
             && route.alternatives is list
             && route.alternatives.size() <= 20
             && (route.weatherNote == null || stringBetween(route.weatherNote, 0, 2000))
             && (!('dataSources' in route) || (route.dataSources is list && route.dataSources.size() <= 20))
             && (!('photo' in route) || (
               route.photo is string
               && route.photo.size() <= 180000
               && route.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
             ))
             && (!('region' in route) || stringBetween(route.region, 0, 120));
    }

    function validRouteDocument(data) {
      return data.keys().hasAll(['authorUid', 'visibility', 'route', 'saveCount', 'createdAt', 'updatedAt'])
             && data.keys().hasOnly(['authorUid', 'visibility', 'route', 'saveCount', 'createdAt', 'updatedAt'])
             && stringBetween(data.authorUid, 1, 128)
             && data.visibility in ['private', 'unlisted', 'public']
             && validRouteBody(data.route)
             && data.saveCount is int
             && data.saveCount >= 0
             && data.createdAt is timestamp
             && data.updatedAt is timestamp;
    }

    function routeCounterChange(routeId) {
      let savedPath = /databases/$(database)/documents/users/$(request.auth.uid)/savedRoutes/$(routeId);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let addedSavedRoute = !exists(savedPath) && existsAfter(savedPath);
      let removedSavedRoute = exists(savedPath) && !existsAfter(savedPath);
      return signedIn()
             && changed.hasOnly(['saveCount', 'updatedAt'])
             && request.resource.data.updatedAt == request.time
             && (
               (addedSavedRoute
                && request.resource.data.saveCount == resource.data.saveCount + 1)
               || (removedSavedRoute
                   && resource.data.saveCount > 0
                   && request.resource.data.saveCount == resource.data.saveCount - 1)
             );
    }

    function savedRouteCounterIncreased(routeId) {
      let routePath = /databases/$(database)/documents/routes/$(routeId);
      return exists(routePath)
             && getAfter(routePath).data.saveCount == get(routePath).data.saveCount + 1;
    }

    function savedRouteCounterDecreased(routeId) {
      let routePath = /databases/$(database)/documents/routes/$(routeId);
      return !existsAfter(routePath)
             || (exists(routePath)
                 && get(routePath).data.saveCount == getAfter(routePath).data.saveCount + 1);
    }

    function validTrackDocument(data) {
      return data.keys().hasAll([
               'id', 'authorUid', 'startedAt', 'endedAt', 'distanceKm',
               'polyline', 'stops', 'accuracy', 'createdAt'
             ])
             && data.keys().hasOnly([
               'id', 'authorUid', 'startedAt', 'endedAt', 'distanceKm',
               'polyline', 'stops', 'accuracy', 'createdAt'
             ])
             && stringBetween(data.id, 1, 128)
             && stringBetween(data.authorUid, 1, 128)
             && data.startedAt is int
             && data.endedAt is int
             && data.endedAt >= data.startedAt
             && data.distanceKm is number
             && data.distanceKm >= 0
             && data.distanceKm <= 100000
             && data.polyline is string
             && data.polyline.size() <= 250000
             && data.stops is list
             && data.stops.size() <= 100
             && data.accuracy is map
             && data.accuracy.keys().hasOnly(['sampleCount', 'meanMeters', 'maxMeters'])
             && data.accuracy.sampleCount is int
             && data.accuracy.sampleCount >= 0
             && data.accuracy.meanMeters is number
             && data.accuracy.meanMeters >= 0
             && data.accuracy.maxMeters is number
             && data.accuracy.maxMeters >= data.accuracy.meanMeters
             && data.createdAt is timestamp;
    }

    function validStoryShape(data) {
      return data.keys().hasAll([
               'author', 'authorUid', 'text', 'accent', 'createdAt', 'kind'
             ])
             && data.keys().hasOnly([
               'author', 'authorUid', 'text', 'accent', 'createdAt',
               'kind', 'placeLabel', 'lng', 'lat', 'photo'
             ])
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && hasTextOrPhoto(data, 500)
             && data.accent in ['sun', 'leaf', 'sea', 'dusk']
             && data.createdAt is timestamp
             && data.kind == 'user'
             && (!('placeLabel' in data) || stringBetween(data.placeLabel, 1, 200))
             && hasValidOptionalLocation(data)
             && hasValidOptionalPhoto(data);
    }

    function validReport(data) {
      return data.keys().hasAll(['reporterUid', 'targetType', 'targetId', 'reason', 'createdAt'])
             && data.keys().hasOnly(['reporterUid', 'targetType', 'targetId', 'targetOwnerUid', 'reason', 'details', 'createdAt'])
             && stringBetween(data.reporterUid, 1, 128)
             && data.reporterUid == request.auth.uid
             && data.targetType in ['place', 'post', 'story', 'user']
             && stringBetween(data.targetId, 1, 200)
             && (!('targetOwnerUid' in data) || stringBetween(data.targetOwnerUid, 1, 128))
             && data.reason in ['spam', 'harassment', 'hate', 'misinfo', 'privacy', 'other']
             && (!('details' in data) || stringBetween(data.details, 1, 1000))
             && data.createdAt == request.time;
    }

    function validBlock(data) {
      return data.keys().hasAll(['blockerUid', 'blockedUid', 'createdAt'])
             && data.keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt'])
             && stringBetween(data.blockerUid, 1, 128)
             && stringBetween(data.blockedUid, 1, 128)
             && data.blockerUid == request.auth.uid
             && data.blockedUid != request.auth.uid
             && data.createdAt == request.time;
    }

    function validVerification(data) {
      return data.keys().hasAll(['placeId', 'uid', 'status', 'createdAt'])
             && data.keys().hasOnly(['placeId', 'uid', 'status', 'createdAt', 'note'])
             && stringBetween(data.placeId, 1, 200)
             && stringBetween(data.uid, 1, 128)
             && data.uid == request.auth.uid
             && data.status in ['still_open', 'fee_changed', 'road_closed', 'free_entry', 'closed']
             && (!('note' in data) || stringBetween(data.note, 1, 280))
             && data.createdAt == request.time;
    }

    function validGroupShape(data) {
      return data.keys().hasAll(['name', 'ownerUid', 'memberUids', 'createdAt', 'updatedAt'])
             && data.keys().hasOnly(['name', 'ownerUid', 'memberUids', 'joinCode', 'createdAt', 'updatedAt', 'lastMessage'])
             && stringBetween(data.name, 1, 80)
             && stringBetween(data.ownerUid, 1, 128)
             && data.ownerUid == request.auth.uid
             && (!('joinCode' in data) || data.joinCode.matches('[0-9]{6,8}'))
             && data.memberUids is list
             && data.memberUids.size() >= 1
             && data.memberUids.size() <= 20
             && data.memberUids.toSet().size() == data.memberUids.size()
             && request.auth.uid in data.memberUids
             && data.createdAt is timestamp
             && data.updatedAt == request.time
             && (!('lastMessage' in data) || validLastMessage(data.lastMessage));
    }

    // KARAR (e): create geriye uyumlu. Eski istemci (kodsuz ya da çok üyeli
    // liste ile) grup oluşturabilir; yeni istemci her zaman 6–8 haneli kod yazar
    // (validGroupShape joinCode'u biçimce denetler). Rules önce deploy edilir.
    function validGroupCreateShape(data) {
      return validGroupShape(data)
             && data.createdAt == request.time;
    }

    function validGroupInvite(data, groupId, invitedUid) {
      return data.keys().hasAll(['invitedUid', 'inviterUid', 'groupId', 'groupName', 'createdAt'])
             && data.keys().hasOnly(['invitedUid', 'inviterUid', 'groupId', 'groupName', 'createdAt'])
             && data.invitedUid == invitedUid
             && stringBetween(data.invitedUid, 1, 128)
             && stringBetween(data.inviterUid, 1, 128)
             && data.inviterUid == request.auth.uid
             && data.groupId == groupId
             && stringBetween(data.groupName, 1, 80)
             && data.createdAt == request.time;
    }

    function validFriendRequest(data, uid, requesterUid) {
      return data.keys().hasAll(['fromUid', 'fromName', 'toUid', 'createdAt'])
             && data.keys().hasOnly(['fromUid', 'fromName', 'toUid', 'createdAt'])
             && data.fromUid == requesterUid
             && data.toUid == uid
             && data.fromUid == request.auth.uid
             && data.fromUid != data.toUid
             && stringBetween(data.fromUid, 1, 128)
             && stringBetween(data.toUid, 1, 128)
             && stringBetween(data.fromName, 2, 100)
             && data.createdAt == request.time;
    }

    function validFriendship(data) {
      return data.keys().hasAll(['users', 'requesterUid', 'recipientUid', 'status', 'createdAt', 'updatedAt'])
             && data.keys().hasOnly(['users', 'requesterUid', 'recipientUid', 'status', 'createdAt', 'updatedAt'])
             && data.users is list
             && data.users.size() == 2
             && data.users.toSet().size() == 2
             && request.auth.uid in data.users
             && stringBetween(data.requesterUid, 1, 128)
             && stringBetween(data.recipientUid, 1, 128)
             && data.requesterUid in data.users
             && data.recipientUid in data.users
             && data.requesterUid != data.recipientUid
             && data.status == 'accepted'
             && data.createdAt == request.time
             && data.updatedAt == request.time;
    }

    function validFriendIndex(data, friendUid) {
      return data.keys().hasAll(['friendUid', 'friendName', 'since'])
             && data.keys().hasOnly(['friendUid', 'friendName', 'since'])
             && data.friendUid == friendUid
             && stringBetween(data.friendUid, 1, 128)
             && stringBetween(data.friendName, 2, 100)
             && data.since == request.time;
    }

    function friendshipId(uidA, uidB) {
      return uidA < uidB ? uidA + "_" + uidB : uidB + "_" + uidA;
    }

    function reverseFriendshipId(fid) {
      let parts = fid.split("_");
      return parts[1] + "_" + parts[0];
    }

    function isAcceptedFriendship(uid, friendUid) {
      let fid = friendshipId(uid, friendUid);
      let path = /databases/$(database)/documents/friendships/$(fid);
      return (exists(path) && get(path).data.status == "accepted" && get(path).data.users.hasAll([uid, friendUid]))
             || (existsAfter(path) && getAfter(path).data.status == "accepted" && getAfter(path).data.users.hasAll([uid, friendUid]));
    }

    function pendingFriendRequestExists(requesterUid, recipientUid) {
      return exists(/databases/$(database)/documents/users/$(recipientUid)/friendRequests/$(requesterUid));
    }

    function validUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'displayNameLower', 'createdAt', 'updatedAt'])
             && data.keys().hasOnly(['uid', 'displayName', 'displayNameLower', 'photoURL', 'createdAt', 'updatedAt'])
             && data.uid == uid
             && data.uid == request.auth.uid
             && stringBetween(data.displayName, 2, 40)
             // Sunucu tarafında lower() YOK: Türkçe İ JS'ten ayrışır (§Aşama 2).
             // Yalnız biçim doğrulanır; normalizasyonu istemci üretir.
             && stringBetween(data.displayNameLower, 2, 40)
             && data.displayNameLower.matches('[a-z0-9 ığüşöçâîû-]+')
             && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500 && data.photoURL.matches('https?://.*')))
             && data.createdAt == request.time
             && data.updatedAt == request.time;
    }

    function validLastMessage(message) {
      return message is map
             && message.keys().hasAll(['text', 'senderUid', 'senderName', 'createdAt'])
             && message.keys().hasOnly(['text', 'senderUid', 'senderName', 'createdAt'])
             && stringBetween(message.text, 1, 200)
             && message.senderUid == request.auth.uid
             && stringBetween(message.senderName, 1, 100)
             && message.createdAt == request.time;
    }

    function validGroupMessage(data) {
      return data.keys().hasAll(['senderUid', 'senderName', 'text', 'createdAt'])
             && data.keys().hasOnly(['senderUid', 'senderName', 'text', 'createdAt'])
             && data.senderUid == request.auth.uid
             && stringBetween(data.senderName, 1, 100)
             && stringBetween(data.text, 1, 1000)
             && data.createdAt == request.time;
    }

    function validGroupIndex(data, groupId) {
      return data.keys().hasAll(['groupId', 'name', 'role', 'joinedAt'])
             && data.keys().hasOnly(['groupId', 'name', 'role', 'joinedAt'])
             && data.groupId == groupId
             && stringBetween(data.name, 1, 80)
             && data.role in ['owner', 'member']
             && data.joinedAt == request.time;
    }

    function validNotification(data) {
      return data.keys().hasAll(['recipientUid', 'actorUid', 'type', 'title', 'body', 'read', 'createdAt'])
             && data.keys().hasOnly(['recipientUid', 'actorUid', 'type', 'title', 'body', 'read', 'createdAt', 'targetId'])
             && stringBetween(data.recipientUid, 1, 128)
             && stringBetween(data.actorUid, 1, 128)
             && data.actorUid == request.auth.uid
             && data.type in ['report_received', 'report_actioned', 'blocked', 'group_invite', 'group_message', 'friend_request', 'friend_accepted', 'friend_declined', 'system']
             && stringBetween(data.title, 1, 200)
             && stringBetween(data.body, 0, 500)
             && data.read is bool
             && data.read == false
             && data.createdAt == request.time
             && (!('targetId' in data) || stringBetween(data.targetId, 1, 200));
    }

    // Ret kanıtı: friend_declined ancak decliner'ın kendi ret belgesiyle yazılır.
    // Diğer tipler bu değişiklikten etkilenmez (dal yalnız friend_declined'a uygulanır).
    function friendDeclineProof(data) {
      return data.type != 'friend_declined'
             || ('targetId' in data
                 && exists(/databases/$(database)/documents/friendDeclines/$(data.targetId))
                 && get(/databases/$(database)/documents/friendDeclines/$(data.targetId)).data.declinerUid == data.actorUid
                 && get(/databases/$(database)/documents/friendDeclines/$(data.targetId)).data.requesterUid == data.recipientUid);
    }

    match /places/{placeId} {
      allow get: if true;
      // Toplam içerik tavanı değil: her overview/viewport/sahip cursor sayfası
      // en fazla 50 kayıt okuyabilir; limitsiz ve aşırı büyük istek fail-closed.
      allow list: if boundedList(50);
      allow create: if signedIn()
                    && validPlaceShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
                    && resource.data.authorUid == request.auth.uid
                    && validPlaceShape(request.resource.data)
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.kind == resource.data.kind
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    match /posts/{postId} {
      allow get: if true;
      // Akış cursor sayfaları 50 kayıtla sınırlıdır; eski kayıtlar sonraki sayfalardadır.
      allow list: if boundedList(50);
      allow create: if signedIn()
                    && validPostShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.likes == 0
                    && request.resource.data.likedBy.size() == 0;
      allow update: if signedIn() && validPostInteraction();
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;

      match /replies/{replyId} {
        function parentPostExists() {
          return exists(/databases/$(database)/documents/posts/$(postId));
        }

        allow get: if parentPostExists();
        allow list: if parentPostExists() && boundedList(100);
        allow create: if signedIn()
                      && parentPostExists()
                      && validReplyShape(request.resource.data);
        allow update: if false;
        allow delete: if signedIn()
                      && (resource.data.authorUid == request.auth.uid
                          || (parentPostExists()
                              && get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid));
      }
    }

    match /stories/{storyId} {
      // PR #51 kusur #5: "24 saat" yalnız istemcideydi. Süresi dolan hikâyeyi id ile
      // yalnız sahibi okur (silebilmek için). Liste kuralı resource.data'ya bağlanamaz
      // (sorgudan türetilen nesne; CI kanıtı #51); liste 50 kayıtla sınırlı kalır ve
      // istemci createdAt >= şimdi-24s filtresini gönderir.
      function storyLive() {
        return resource.data.createdAt >= request.time - duration.value(24, 'h');
      }
      allow get: if storyLive()
                 || (signedIn() && resource.data.authorUid == request.auth.uid);
      // 24 saatlik pencere de cursor ile 50 kayıtlık sayfalara ayrılır.
      allow list: if boundedList(50);
      allow create: if signedIn()
                    && validStoryShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    match /routes/{routeId} {
      // public ve unlisted rotalar bağlantıyla; private yalnız sahip tarafından okunur.
      allow get: if resource.data.visibility in ['public', 'unlisted']
                 || (signedIn() && resource.data.authorUid == request.auth.uid);
      // Keşif sorgusu public görünürlüğü açıkça filtreler; sahip kendi kayıtlarını sorgulayabilir.
      allow list: if boundedList(40)
                  && (resource.data.visibility == 'public'
                      || (signedIn() && resource.data.authorUid == request.auth.uid));
      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.route.id == routeId
                    && request.resource.data.saveCount == 0
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && validRouteDocument(request.resource.data);
      allow update: if signedIn()
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.route.id == routeId
                    && validRouteDocument(request.resource.data)
                    && (
                      (resource.data.authorUid == request.auth.uid
                       && request.resource.data.saveCount == resource.data.saveCount
                       && request.resource.data.updatedAt == request.time)
                      || routeCounterChange(routeId)
                    );
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /tracks/{trackId} {
      allow get: if signedIn() && resource.data.authorUid == request.auth.uid;
      allow list: if signedIn() && resource.data.authorUid == request.auth.uid && boundedList(100);
      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.id == trackId
                    && request.resource.data.createdAt == request.time
                    && validTrackDocument(request.resource.data);
      allow update: if signedIn()
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.id == trackId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && validTrackDocument(request.resource.data);
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /users/{uid}/savedPlaces/{placeId} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if signedIn() && request.auth.uid == uid && boundedList(100);
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['place', 'savedAt'])
                            && request.resource.data.keys().hasAll(['place', 'savedAt'])
                            && request.resource.data.place is map
                            && request.resource.data.place.id == placeId
                            && request.resource.data.savedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/savedRoutes/{routeId} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if signedIn() && request.auth.uid == uid && boundedList(100);
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['routeId', 'savedAt'])
                    && request.resource.data.keys().hasAll(['routeId', 'savedAt'])
                    && request.resource.data.routeId == routeId
                    && request.resource.data.savedAt == request.time
                    && savedRouteCounterIncreased(routeId);
      allow update: if false;
      allow delete: if signedIn()
                    && request.auth.uid == uid
                    && savedRouteCounterDecreased(routeId);
    }

    // ───────────────────── Takip (İŞ 1d) ─────────────────────
    // Şema dar: yalnız hedef kimliği, adı ve zaman. Sahibi dışında kimse
    // yazamaz, kendini takip edemez. Okuma yalnız sahibine açıktır.
    match /users/{uid}/following/{targetUid} {
      function validFollow(data) {
        return data.keys().hasAll(['targetUid', 'targetName', 'since'])
               && data.keys().hasOnly(['targetUid', 'targetName', 'since'])
               && data.targetUid == targetUid
               && stringBetween(data.targetUid, 1, 128)
               && stringBetween(data.targetName, 1, 100)
               && data.since == request.time;
      }
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if signedIn() && request.auth.uid == uid && boundedList(100);
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && targetUid != uid
                    && validFollow(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Takipçi sayısı collection-group count() ile hesaplanır (Spark planında
    // çalışır). Toplama sorgusu limit göndermediği için burada boundedList
    // KULLANILMAZ; sınır yerine kanıt var: liste yalnız `targetUid == kendi uid`
    // koşulunu taşıyan sorguya açılır (kural filtre değil, kanıt ister; istemci
    // where taşımak zorunda). Kimse başkasının takipçi listesini çekemez.
    match /{path=**}/following/{targetUid} {
      allow list: if signedIn() && resource.data.targetUid == request.auth.uid;
    }

    // Yanıtların collection-group listesi: yalnız yazarın kendi yanıtları (hesap silme).
    // Doğrudan posts/{id}/replies kuralları değişmez; bu yalnız collection-group sorgusuna uygulanır.
    match /{path=**}/replies/{replyId} {
      allow list: if signedIn()
                  && resource.data.authorUid == request.auth.uid
                  && boundedList(50);
    }

    // P4 geri bildirim kanalı. KARAR: yalnız giriş yapmış kullanıcı en fazla
    // dar şemalı kayıt yazar. get/update yok. Liste ve silme yalnız sahibine
    // açıktır; bu, hesap silmenin kendi geri bildirimini silebilmesi içindir.
    // Konum ve cihaz parmak izi alanı kabul edilmez (hasOnly).
    match /feedback/{feedbackId} {
      allow get: if false;
      allow list: if signedIn() && resource.data.uid == request.auth.uid && boundedList(50);
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'category', 'message', 'appVersion', 'createdAt'])
                    && request.resource.data.keys().hasAll(['uid', 'category', 'message', 'appVersion', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.category in ['bug', 'idea', 'other']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 1
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.appVersion is string
                    && request.resource.data.appVersion.size() <= 40
                    && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Tazelik doğrulamaları: okuma GİRİŞ ŞARTI (Aşama 3-A), yalnız kendi adına yazma.
    // `note` 280 karaktere kadar serbest metin taşıdığı için anonim okuma kapatıldı.
    // Liste isteği 50 kayıtla sınırlıdır; canlı dinleyici tek pencere tutar.
    match /verifications/{verificationId} {
      allow get: if signedIn();
      allow list: if signedIn() && boundedList(50);
      // İŞ 1d: kimlik {placeId}_{uid} olmak ZORUNDA. Kimlik sınırlanmadığında
      // aynı kişi aynı yere sınırsız doğrulama yazabiliyordu (badge sayaçlarını
      // şişirme). Eski `vr-…` belgeleri okunmaya/silinmeye devam eder; kural
      // yalnız yeni yazımı bağlar (update zaten kapalı).
      allow create: if signedIn()
                    && validVerification(request.resource.data)
                    && verificationId == request.resource.data.placeId + "_" + request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow get: if signedIn() && resource.data.reporterUid == request.auth.uid;
      allow list: if signedIn() && boundedList(50)
                    && resource.data.reporterUid == request.auth.uid;
      allow create: if signedIn() && validReport(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.reporterUid == request.auth.uid;
    }

    match /blocks/{blockId} {
      allow get: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow list: if signedIn() && boundedList(50)
                    && resource.data.blockerUid == request.auth.uid;
      allow create: if signedIn() && validBlock(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
    }

    // ─────────────────────────── Adım 16 · grup + sohbet ───────────────────────────
    // Okuma sınırı: grup listesi kullanıcının kendi indeksinden (limit 20), mesajlar
    // tek grupta en yeni 50 kayıttan okunur. Realtime Database veya üçüncü taraf yok.
    match /groups/{groupId} {
      allow get: if signedIn() && request.auth.uid in resource.data.memberUids;
      // Geniş koleksiyon taraması kapalı: kullanıcı yalnız üyesi olduğu grubu tek
      // belge olarak okur; liste kendi users/{uid}/groups indeksinden gelir.
      allow list: if false;
      allow create: if signedIn()
                    && validGroupCreateShape(request.resource.data)
                    // Rıza (PR #51 kusur #4): kuruluşta üye listesi TAM OLARAK [kurucu].
                    // Başkaları yalnız davet kabulü (invites/{uid}) ya da katılma kodu
                    // (joinAttempts/{uid}) ile girer. İstemci createGroup zaten böyle yazar.
                    && request.resource.data.memberUids.hasOnly([request.auth.uid]);
      allow update: if signedIn()
                    && (
                      // Kurucu metadata gunceller (isim/kod) — uye listesi degismez
                      (
                        resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.memberUids == resource.data.memberUids
                        // Kodlu grup kodsuz bırakılamaz; kodsuz eski grup kodsuz kalarak adını değiştirebilir.
                        && (
                          ('joinCode' in request.resource.data && request.resource.data.joinCode.matches('[0-9]{6,8}'))
                          || (!('joinCode' in resource.data) && !('joinCode' in request.resource.data))
                        )
                        && validGroupShape(request.resource.data)
                      ) || (
                        // Eski gruba kod ekleme: joinCode yoksa kurucu ekleyebilir (backward compat)
                        resource.data.ownerUid == request.auth.uid
                        && !('joinCode' in resource.data)
                        && 'joinCode' in request.resource.data
                        && request.resource.data.joinCode.matches('[0-9]{6,8}')
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.memberUids == resource.data.memberUids
                        && validGroupShape(request.resource.data)
                      ) || (
                        // Uye son mesaji yazar
                        request.auth.uid in resource.data.memberUids
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
                        && validLastMessage(request.resource.data.lastMessage)
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && ((!('joinCode' in resource.data) && !('joinCode' in request.resource.data)) || request.resource.data.joinCode == resource.data.joinCode)
                        && request.resource.data.memberUids == resource.data.memberUids
                        // PR #51 kusur #1: hasOnly alana izin verir, DEĞERİ kısıtlamaz; üye
                        // updatedAt'i keyfi zamana yazabiliyordu. İstemci serverTimestamp() gönderir.
                        && request.resource.data.updatedAt == request.time
                      ) || (
                        // Uye ayrilir — yalniz kendini cikarir
                        request.auth.uid in resource.data.memberUids
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && ((!('joinCode' in resource.data) && !('joinCode' in request.resource.data)) || request.resource.data.joinCode == resource.data.joinCode)
                        && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
                        && request.resource.data.updatedAt == request.time
                      ) || (
                        // Davetli kabul — yalniz kendini ekler, davet varligi kanitli
                        !(request.auth.uid in resource.data.memberUids)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                        && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
                        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
                        && request.resource.data.memberUids.size() <= 20
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && ((!('joinCode' in resource.data) && !('joinCode' in request.resource.data)) || request.resource.data.joinCode == resource.data.joinCode)
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.updatedAt == request.time
                        && exists(/databases/$(database)/documents/groups/$(groupId)/invites/$(request.auth.uid))
                      ) || (
                        // Kod ile katılma (okumasız): üye olmayan yalnız kendini ekler. Kod,
                        // kullanıcının KENDİ deneme belgesinde (ayrı, önceden commit edilmiş
                        // yazım) bulunmalı; deneme sayacı 5'i aşmamış ve yazım son 2 dakikada olmalı.
                        !(request.auth.uid in resource.data.memberUids)
                        && 'joinCode' in resource.data
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                        && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
                        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
                        && request.resource.data.memberUids.size() <= 20
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && request.resource.data.joinCode == resource.data.joinCode
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.updatedAt == request.time
                        && get(/databases/$(database)/documents/groups/$(groupId)/joinAttempts/$(request.auth.uid)).data.code == resource.data.joinCode
                        && get(/databases/$(database)/documents/groups/$(groupId)/joinAttempts/$(request.auth.uid)).data.attempts <= 5
                        && request.time < get(/databases/$(database)/documents/groups/$(groupId)/joinAttempts/$(request.auth.uid)).data.at + duration.value(2, 'm')
                      )
                    );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /messages/{messageId} {
        function groupMembers() {
          // PR #51 kusur #3: silinmiş grupta get(...).data null olur ve kural
          // değerlendirme hatasına düşerdi; artık boş liste ile temiz ret.
          return exists(/databases/$(database)/documents/groups/$(groupId))
                 ? get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                 : [];
        }
        allow get: if signedIn() && request.auth.uid in groupMembers();
        allow list: if signedIn() && boundedList(50) && request.auth.uid in groupMembers();
        allow create: if signedIn()
                      && request.auth.uid in groupMembers()
                      && validGroupMessage(request.resource.data);
        allow update: if false;
        // Gönderen kendi mesajını siler; grup sahibi grup silinirken yetim mesajları
        // temizleyebilir (yalnız sahibi; üye başkasının mesajını silemez).
        allow delete: if signedIn() && (
                        resource.data.senderUid == request.auth.uid
                        || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid
                      );
      }

      // Katılma denemesi (sunucu zorunlu sayaç): yalnız kendi belgesini okur/yazar,
      // silemez. Pencere 15 dk (sabit, windowStart'tan). Pencere içinde en fazla 5
      // deneme: önceki attempts < 5 ve attempts +1. Pencere dolunca sayaç 1'e döner.
      // Kod, grup güncellemesinde get() ile okunur; istemci attempts'i geri yazamaz.
      match /joinAttempts/{joinId} {
        function attemptShape(data) {
          return data.keys().hasAll(['code', 'at', 'attempts', 'windowStart'])
                 && data.keys().hasOnly(['code', 'at', 'attempts', 'windowStart'])
                 && data.code is string
                 && data.code.matches('[0-9]{6,8}')
                 && data.at == request.time
                 && data.attempts is int
                 && data.windowStart is timestamp;
        }
        allow get: if signedIn() && joinId == request.auth.uid;
        allow list: if false;
        allow create: if signedIn()
                      && joinId == request.auth.uid
                      && attemptShape(request.resource.data)
                      && request.resource.data.attempts == 1
                      && request.resource.data.windowStart == request.time;
        allow update: if signedIn()
                      && joinId == request.auth.uid
                      && attemptShape(request.resource.data)
                      && (
                        (
                          request.time < resource.data.windowStart + duration.value(15, 'm')
                          && resource.data.attempts < 5
                          && request.resource.data.attempts == resource.data.attempts + 1
                          && request.resource.data.windowStart == resource.data.windowStart
                        ) || (
                          request.time >= resource.data.windowStart + duration.value(15, 'm')
                          && request.resource.data.attempts == 1
                          && request.resource.data.windowStart == request.time
                        )
                      );
        // Hesap silme: yalnız kendi belgesi ve 15 dk penceresi dolmuşsa silinir.
        // Pencere içindeki kayıt silinemez (sayaç atlatılmasın); hesap silmede açık kalır.
        allow delete: if signedIn()
                      && joinId == request.auth.uid
                      && request.time >= resource.data.windowStart + duration.value(15, 'm');
      }

      // Grup davetleri: yalniz kurucu davet edebilir, yalniz davetli gorebilir/kabul edebilir
      match /invites/{invitedUid} {
        allow get: if signedIn()
                   && (invitedUid == request.auth.uid
                       || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid
                       || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids);
        allow list: if signedIn()
                    && boundedList(50)
                    && (resource.data.invitedUid == request.auth.uid
                        || resource.data.inviterUid == request.auth.uid);
        allow create: if signedIn()
                      && validGroupInvite(request.resource.data, groupId, invitedUid)
                      && (
                        (exists(/databases/$(database)/documents/groups/$(groupId)) && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid)
                        || (existsAfter(/databases/$(database)/documents/groups/$(groupId)) && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid)
                      )
                      && (
                        (exists(/databases/$(database)/documents/groups/$(groupId)) && !(invitedUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids))
                        || (existsAfter(/databases/$(database)/documents/groups/$(groupId)) && !(invitedUid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberUids))
                      )
                      && isAcceptedFriendship(request.auth.uid, invitedUid);
        allow update: if false;
        allow delete: if signedIn()
                      && (resource.data.invitedUid == request.auth.uid
                          || resource.data.inviterUid == request.auth.uid
                          || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid);
      }
    }

    // Kullanıcının kendi grup indeksi: listeleme buradan yapılır (limit 20).
    match /users/{uid}/groups/{groupId} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if signedIn() && uid == request.auth.uid && boundedList(20);
      allow create: if signedIn() && uid == request.auth.uid
                    && validGroupIndex(request.resource.data, groupId)
                    // PR #51 kusur #2: indeks GERÇEK üyeliği yansıtmalı; rol, grup
                    // belgesindeki sahiplikle birebir tutarlı olmalı. İstemci indeksi
                    // her zaman grup yazımından SONRA yazar (get güvenli).
                    && exists(/databases/$(database)/documents/groups/$(groupId))
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                    && (request.resource.data.role == 'owner')
                       == (get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid);
      allow update: if false;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // Grup davet aynası: kullanıcının kendi davet kutusu (UI icin)
    match /users/{uid}/groupInvites/{groupId} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if signedIn() && uid == request.auth.uid && boundedList(50);
      allow create: if signedIn()
                    && request.resource.data.invitedUid == uid
                    && request.resource.data.inviterUid == request.auth.uid
                    && request.resource.data.groupId == groupId
                    && validGroupInvite(request.resource.data, groupId, uid)
                    && (
                      (exists(/databases/$(database)/documents/groups/$(groupId)) && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid)
                      || (existsAfter(/databases/$(database)/documents/groups/$(groupId)) && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid)
                    )
                    && (
                      (exists(/databases/$(database)/documents/groups/$(groupId)) && !(uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids))
                      || (existsAfter(/databases/$(database)/documents/groups/$(groupId)) && !(uid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberUids))
                    )
                    && isAcceptedFriendship(request.auth.uid, uid);
      allow update: if false;
      allow delete: if signedIn() && (uid == request.auth.uid || resource.data.inviterUid == request.auth.uid || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid);
    }

    // Notifications: kullanıcı subcollection — yalnız alıcı okur, aktör yazar (engelleme hariç)
    match /users/{uid}/notifications/{notificationId} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if signedIn() && uid == request.auth.uid && boundedList(50);
      allow create: if signedIn() && validNotification(request.resource.data) && request.resource.data.recipientUid == uid && friendDeclineProof(request.resource.data);
      allow update: if signedIn() && uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read is bool;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // Blocks subcollection (alternatif yol) — üstteki top-level ile aynı, uyumluluk için
    match /users/{uid}/blocks/{blockedId} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if signedIn() && uid == request.auth.uid && boundedList(50);
      allow create: if signedIn() && uid == request.auth.uid && request.resource.data.blockerUid == uid && request.resource.data.blockedUid == blockedId && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /userProfiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && boundedList(20);
      allow create: if signedIn() && validUserProfile(request.resource.data, uid);
      allow update: if signedIn() && validUserProfile(request.resource.data, uid) && resource.data.uid == request.auth.uid && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid}/friendRequests/{requesterUid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if signedIn() && uid == request.auth.uid && boundedList(50);
      allow create: if signedIn()
                    && validFriendRequest(request.resource.data, uid, requesterUid)
                    && requesterUid == request.resource.data.fromUid
                    && !exists(/databases/$(database)/documents/friendships/$(friendshipId(uid, requesterUid)))
                    && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/friendRequests/$(uid));
      allow delete: if signedIn() && (uid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow update: if false;
    }

    // C1: sadece kendi friend-listene yazabilirsin; baska kullanici listesi yasak — valid friendship gerekli
    match /users/{uid}/friends/{friendUid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if signedIn() && uid == request.auth.uid && boundedList(100);
      allow create: if signedIn()
                    && uid == request.auth.uid
                    && validFriendIndex(request.resource.data, friendUid)
                    && isAcceptedFriendship(uid, friendUid);
      allow update: if false;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // Kabul edilmis arkadasliklar (atomik): yalniz users icinde olanlar okur/siler
    // Gercek bekleyen istegin alici tarafindan kabul edildigini Rules'ta kanitla — kurallari gevseltme
    // C1: ayni batch'te karsilikli onay — pending istek getAfter ile yok olmali, writeBatch ile atomik
    match /friendships/{fid} {
      allow get: if signedIn() && request.auth.uid in resource.data.users;
      allow list: if false;
      allow create: if signedIn()
                    && validFriendship(request.resource.data)
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.recipientUid == request.auth.uid
                    && request.resource.data.users.hasAll([request.resource.data.requesterUid, request.resource.data.recipientUid])
                    && fid == friendshipId(request.resource.data.requesterUid, request.resource.data.recipientUid)
                    && pendingFriendRequestExists(request.resource.data.requesterUid, request.resource.data.recipientUid)
                    && !existsAfter(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)/friendRequests/$(request.resource.data.requesterUid));
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Ret kanıtı: reddeden kullanıcı, isteği sildiği batch'te yazar.
    // Kanıt yoksa friend_declined bildirimi de yazılamaz (friendDeclineProof).
    match /friendDeclines/{fid} {
      allow get: if signedIn() && request.auth.uid in resource.data.users;
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.keys().hasAll(['declinerUid', 'requesterUid', 'users', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['declinerUid', 'requesterUid', 'users', 'createdAt'])
                    && stringBetween(request.resource.data.declinerUid, 1, 128)
                    && stringBetween(request.resource.data.requesterUid, 1, 128)
                    && request.auth.uid == request.resource.data.declinerUid
                    && request.resource.data.declinerUid != request.resource.data.requesterUid
                    && request.resource.data.users is list
                    && request.resource.data.users.size() == 2
                    && request.resource.data.users.hasAll([request.resource.data.declinerUid, request.resource.data.requesterUid])
                    && fid == friendshipId(request.resource.data.declinerUid, request.resource.data.requesterUid)
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.declinerUid)/friendRequests/$(request.resource.data.requesterUid))
                    && !existsAfter(/databases/$(database)/documents/users/$(request.resource.data.declinerUid)/friendRequests/$(request.resource.data.requesterUid))
                    && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == resource.data.declinerUid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
