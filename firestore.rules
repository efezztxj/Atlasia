rules_version = '2';

// Atlasia — Firestore güvenlik kuralları
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function boundedList(maxItems) {
      return request.query.limit != null && request.query.limit <= maxItems;
    }

    function stringBetween(value, minSize, maxSize) {
      return value is string
             && value.size() >= minSize
             && value.size() <= maxSize;
    }

    function validPhotoValue(value, maxSize) {
      return value is string
             && value.size() <= maxSize
             && value.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }

    function hasValidPhoto(data) {
      return ('photo' in data) && validPhotoValue(data.photo, 180000);
    }

    function hasValidOptionalPhoto(data) {
      return !('photo' in data) || hasValidPhoto(data);
    }

    // Mevcut tek fotoğraflı pinler değişmeden kalır. Yeni galeriler ilk fotoğrafla
    // birlikte en fazla iki küçük JPEG içerebilir (medya üst sınırı 380 KB).
    function hasValidPlaceGallery(data) {
      return !('gallery' in data) || (
        hasValidPhoto(data)
        && data.gallery is list
        && data.gallery.size() > 0
        && data.gallery.size() <= 2
        && validPhotoValue(data.gallery[0], 100000)
        && data.gallery[0] != data.photo
        && (data.gallery.size() == 1 || (
          validPhotoValue(data.gallery[1], 100000)
          && data.gallery[1] != data.photo
          && data.gallery[1] != data.gallery[0]
        ))
      );
    }

    function hasTextOrPhoto(data, maxTextSize) {
      return data.text is string
             && data.text.size() <= maxTextSize
             && (data.text.size() > 0 || hasValidPhoto(data));
    }

    // JS /\S+/gu ile aynı sözcük tanımı: RE2 \s Unicode ayırıcıları,
    // dikey sekmeyi (0B) ve BOM'u (FEFF) kapsamaz. Her sözcük bir 'x'e
    // çevrilip boşluklar kaldırılınca kalan uzunluk sözcük sayısıdır.
    function validPlaceNote(note) {
      return stringBetween(note, 0, 5000)
             && note.replace('[^\\s\\p{Z}\\x{0B}\\x{FEFF}]+', 'x')
                    .replace('[\\s\\p{Z}\\x{0B}\\x{FEFF}]+', '').size() <= 300;
    }

    function hasValidOptionalLocation(data) {
      return (
        !('lng' in data)
        && !('lat' in data)
      ) || (
        ('lng' in data)
        && ('lat' in data)
        && data.lng is number
        && data.lng >= -180
        && data.lng <= 180
        && data.lat is number
        && data.lat >= -90
        && data.lat <= 90
      );
    }

    function validPlaceShape(data) {
      return data.keys().hasAll([
               'title', 'region', 'category', 'lng', 'lat', 'note',
               'author', 'authorUid', 'kind', 'createdAt'
             ])
             && data.keys().hasOnly([
               'title', 'region', 'category', 'lng', 'lat', 'note',
               'author', 'authorUid', 'kind', 'createdAt', 'photo', 'gallery'
             ])
             && stringBetween(data.title, 1, 200)
             && stringBetween(data.region, 0, 200)
             && data.category in [
               'cities', 'beaches', 'history', 'nature', 'camp', 'food',
               'photo', 'routes', 'community', 'issues'
             ]
             && data.lng is number
             && data.lng >= -180
             && data.lng <= 180
             && data.lat is number
             && data.lat >= -90
             && data.lat <= 90
             && stringBetween(data.note, 0, 5000)
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && data.kind == 'user'
             && data.createdAt is timestamp
             && hasValidOptionalPhoto(data)
             && hasValidPlaceGallery(data);
    }

    function validPostShape(data) {
      return data.keys().hasAll([
               'author', 'authorUid', 'text', 'createdAt', 'likes',
               'likedBy', 'replies', 'kind'
             ])
             && data.keys().hasOnly([
               'author', 'authorUid', 'text', 'createdAt', 'likes',
               'likedBy', 'replies', 'kind', 'placeLabel', 'lng', 'lat', 'photo'
             ])
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && hasTextOrPhoto(data, 5000)
             && data.createdAt is timestamp
             && data.likes is int
             && data.likes >= 0
             && data.likedBy is list
             && data.likedBy.size() <= 500
             && data.likedBy.toSet().size() == data.likedBy.size()
             && data.replies is list
             && data.replies.size() <= 100
             && data.kind == 'user'
             && (!('placeLabel' in data) || stringBetween(data.placeLabel, 1, 200))
             && hasValidOptionalLocation(data)
             && hasValidOptionalPhoto(data);
    }

    function validLikeToggle() {
      let before = resource.data.likedBy;
      let after = request.resource.data.likedBy;
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());
      return before is list
             && after is list
             && after.size() <= 500
             && after.toSet().size() == after.size()
             && (
               (
                 after.size() == before.size() + 1
                 && added.size() == 1
                 && added.hasOnly([request.auth.uid])
                 && removed.size() == 0
               ) || (
                 after.size() == before.size() - 1
                 && removed.size() == 1
                 && removed.hasOnly([request.auth.uid])
                 && added.size() == 0
               )
             );
    }

    function validReply(reply) {
      return reply is map
             && reply.keys().hasAll([
               'id', 'author', 'authorUid', 'text', 'createdAt', 'likes', 'kind'
             ])
             && reply.keys().hasOnly([
               'id', 'author', 'authorUid', 'text', 'createdAt', 'likes', 'kind'
             ])
             && stringBetween(reply.id, 1, 100)
             && stringBetween(reply.author, 1, 100)
             && reply.authorUid == request.auth.uid
             && stringBetween(reply.text, 1, 1000)
             && reply.createdAt is int
             && reply.likes == 0
             && reply.kind == 'user';
    }

    function validReplyAppend() {
      let before = resource.data.replies;
      let after = request.resource.data.replies;
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());
      let candidate = after[after.size() - 1];
      return before is list
             && after is list
             && after.size() == before.size() + 1
             && after.size() <= 100
             && removed.size() == 0
             && added.size() == 1
             && added.hasOnly([candidate])
             && validReply(candidate);
    }

    function validPostInteraction() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() == 0 || (
        changed.size() == 1
        && changed.hasOnly(['likedBy'])
        && validLikeToggle()
      ) || (
        changed.size() == 1
        && changed.hasOnly(['replies'])
        && validReplyAppend()
      );
    }

    function validStoryShape(data) {
      return data.keys().hasAll([
               'author', 'authorUid', 'text', 'accent', 'createdAt', 'seen', 'kind'
             ])
             && data.keys().hasOnly([
               'author', 'authorUid', 'text', 'accent', 'createdAt', 'seen',
               'kind', 'placeLabel', 'lng', 'lat', 'photo'
             ])
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && hasTextOrPhoto(data, 500)
             && data.accent in ['sun', 'leaf', 'sea', 'dusk']
             && data.createdAt is timestamp
             && data.seen == false
             && data.kind == 'user'
             && (!('placeLabel' in data) || stringBetween(data.placeLabel, 1, 200))
             && hasValidOptionalLocation(data)
             && hasValidOptionalPhoto(data);
    }

    match /places/{placeId} {
      allow get: if true;
      // Toplam içerik tavanı değil: her overview/viewport/sahip cursor sayfası
      // en fazla 50 kayıt okuyabilir; limitsiz ve aşırı büyük istek fail-closed.
      allow list: if boundedList(50);
      allow create: if signedIn()
                    && validPlaceShape(request.resource.data)
                    && validPlaceNote(request.resource.data.note)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
                    && resource.data.authorUid == request.auth.uid
                    && validPlaceShape(request.resource.data)
                    // Eski 300+ kelimelik pinler okunup diğer alanları güncellenebilir;
                    // not değişirse yeni sınır zorunlu, eski kayıtlar silinmez.
                    && (request.resource.data.note == resource.data.note
                        || validPlaceNote(request.resource.data.note))
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.kind == resource.data.kind
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    match /posts/{postId} {
      allow get: if true;
      // Akış cursor sayfaları 50 kayıtla sınırlıdır; eski kayıtlar sonraki sayfalardadır.
      allow list: if boundedList(50);
      allow create: if signedIn()
                    && validPostShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.likes == 0
                    && request.resource.data.likedBy.size() == 0
                    && request.resource.data.replies.size() == 0;
      allow update: if signedIn() && validPostInteraction();
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    match /stories/{storyId} {
      allow get: if true;
      // 24 saatlik pencere de cursor ile 50 kayıtlık sayfalara ayrılır.
      allow list: if boundedList(50);
      allow create: if signedIn()
                    && validStoryShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
