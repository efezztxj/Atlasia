rules_version = '2';

// Atlasia — Firestore güvenlik kuralları
// Bu dosyayı Firebase Console > Firestore > Rules sekmesine yapıştır.
// Test modundaki açık kuralları bununla değiştirdiğinde production'a hazır olursun.

service cloud.firestore {
  match /databases/{database}/documents {

    // Fotoğraflar ücretli dosya depolaması gerektirmemesi için istemcide
    // JPEG'e sıkıştırılıp veri URL'i olarak içerik dokümanına yazılır.
    function hasValidPhoto(data) {
      return ('photo' in data)
             && data.photo is string
             && data.photo.size() <= 180000
             && data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }

    function hasValidOptionalPhoto(data) {
      return !('photo' in data) || hasValidPhoto(data);
    }

    function hasTextOrPhoto(data, maxTextSize) {
      return data.text is string
             && data.text.size() < maxTextSize
             && (data.text.size() > 0 || hasValidPhoto(data));
    }

    // Kullanıcı profilleri: herkes herkesin public bilgilerini (isim, xp, rozet)
    // görebilir ama sadece kendi dokümanını yazabilir.
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    // XP ve level sunucuda güncellenir, kullanıcı yazamamalı
                    && (!('xp' in request.resource.data) || request.resource.data.xp == resource.data.xp)
                    && (!('level' in request.resource.data) || request.resource.data.level == resource.data.level);
      allow delete: if false;

      // Takip listeleri kendi dokümanındadır, ayrı subcollection'a gerek yok.
    }

    // Keşif pinleri: herkes okuyabilir, sadece giriş yapmış kullanıcı kendi pinini yazabilir.
    match /places/{placeId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() < 200
                    && request.resource.data.lng is number
                    && request.resource.data.lat is number
                    && hasValidOptionalPhoto(request.resource.data);
      allow update: if request.auth != null
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == resource.data.authorUid
                    && hasValidOptionalPhoto(request.resource.data);
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }

    // Postlar: herkes okuyabilir, sadece sahibi silebilir.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && hasTextOrPhoto(request.resource.data, 5000)
                    && hasValidOptionalPhoto(request.resource.data);
      // Diğer kullanıcılar yalnız beğeni ve yanıt alanlarını değiştirebilir;
      // gönderinin metni, fotoğrafı, yazarı ve konumu sabit kalır.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['likes', 'likedBy', 'replies']);
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;

      // Yanıtlar post dokümanının içinde tutuluyor; ayrı subcollection kullanılmıyor.
    }

    // Story'ler: herkes okuyabilir, sadece sahibi silebilir.
    match /stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && hasTextOrPhoto(request.resource.data, 500)
                    && hasValidOptionalPhoto(request.resource.data);
      allow update: if request.auth != null
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == resource.data.authorUid
                    && hasValidOptionalPhoto(request.resource.data);
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }

    // Bilinmeyen koleksiyonlara erişimi engelle.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
