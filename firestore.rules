rules_version = '2';

// Atlasia — Firestore güvenlik kuralları
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownedBy(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function boundedList(maxItems) {
      return request.query.limit != null && request.query.limit <= maxItems;
    }

    function stringBetween(value, minSize, maxSize) {
      return value is string
             && value.size() >= minSize
             && value.size() <= maxSize;
    }

    function hasValidPhoto(data) {
      return ('photo' in data)
             && data.photo is string
             && data.photo.size() <= 180000
             && data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }

    function hasValidOptionalPhoto(data) {
      return !('photo' in data) || hasValidPhoto(data);
    }

    function hasTextOrPhoto(data, maxTextSize) {
      return data.text is string
             && data.text.size() <= maxTextSize
             && (data.text.size() > 0 || hasValidPhoto(data));
    }

    function hasValidOptionalLocation(data) {
      return (
        !('lng' in data)
        && !('lat' in data)
      ) || (
        ('lng' in data)
        && ('lat' in data)
        && data.lng is number
        && data.lng >= -180
        && data.lng <= 180
        && data.lat is number
        && data.lat >= -90
        && data.lat <= 90
      );
    }

    function validProfileShape(data) {
      return data.keys().hasAll([
               'displayName', 'createdAt', 'xp', 'level', 'badges',
               'following', 'followers'
             ])
             && data.keys().hasOnly([
               'displayName', 'bio', 'photoURL', 'createdAt', 'xp', 'level',
               'badges', 'following', 'followers'
             ])
             && stringBetween(data.displayName, 1, 100)
             && (!('bio' in data) || stringBetween(data.bio, 0, 500))
             && (!('photoURL' in data) || stringBetween(data.photoURL, 1, 2000))
             && data.createdAt is timestamp
             && data.xp is int
             && data.xp >= 0
             && data.level is int
             && data.level >= 1
             && data.badges is list
             && data.badges.size() <= 100
             && data.following is list
             && data.following.size() <= 500
             && data.following.toSet().size() == data.following.size()
             && data.followers is list
             && data.followers.size() <= 500
             && data.followers.toSet().size() == data.followers.size();
    }

    function validPlaceShape(data) {
      return data.keys().hasAll([
               'title', 'region', 'category', 'lng', 'lat', 'note',
               'author', 'authorUid', 'kind', 'createdAt'
             ])
             && data.keys().hasOnly([
               'title', 'region', 'category', 'lng', 'lat', 'note',
               'author', 'authorUid', 'kind', 'createdAt', 'photo'
             ])
             && stringBetween(data.title, 1, 200)
             && stringBetween(data.region, 0, 200)
             && data.category in [
               'cities', 'beaches', 'history', 'nature', 'camp', 'food',
               'photo', 'routes', 'community', 'issues'
             ]
             && data.lng is number
             && data.lng >= -180
             && data.lng <= 180
             && data.lat is number
             && data.lat >= -90
             && data.lat <= 90
             && stringBetween(data.note, 0, 5000)
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && data.kind == 'user'
             && data.createdAt is timestamp
             && hasValidOptionalPhoto(data);
    }

    function validPostShape(data) {
      return data.keys().hasAll([
               'author', 'authorUid', 'text', 'createdAt', 'likes',
               'likedBy', 'replies', 'kind'
             ])
             && data.keys().hasOnly([
               'author', 'authorUid', 'text', 'createdAt', 'likes',
               'likedBy', 'replies', 'kind', 'placeLabel', 'lng', 'lat', 'photo'
             ])
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && hasTextOrPhoto(data, 5000)
             && data.createdAt is timestamp
             && data.likes is int
             && data.likes >= 0
             && data.likedBy is list
             && data.likedBy.size() <= 500
             && data.likedBy.toSet().size() == data.likedBy.size()
             && data.replies is list
             && data.replies.size() <= 100
             && data.kind == 'user'
             && (!('placeLabel' in data) || stringBetween(data.placeLabel, 1, 200))
             && hasValidOptionalLocation(data)
             && hasValidOptionalPhoto(data);
    }

    function validLikeToggle() {
      let before = resource.data.likedBy;
      let after = request.resource.data.likedBy;
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());
      return before is list
             && after is list
             && after.size() <= 500
             && after.toSet().size() == after.size()
             && (
               (
                 after.size() == before.size() + 1
                 && added.size() == 1
                 && added.hasOnly([request.auth.uid])
                 && removed.size() == 0
               ) || (
                 after.size() == before.size() - 1
                 && removed.size() == 1
                 && removed.hasOnly([request.auth.uid])
                 && added.size() == 0
               )
             );
    }

    function validReply(reply) {
      return reply is map
             && reply.keys().hasAll([
               'id', 'author', 'authorUid', 'text', 'createdAt', 'likes', 'kind'
             ])
             && reply.keys().hasOnly([
               'id', 'author', 'authorUid', 'text', 'createdAt', 'likes', 'kind'
             ])
             && stringBetween(reply.id, 1, 100)
             && stringBetween(reply.author, 1, 100)
             && reply.authorUid == request.auth.uid
             && stringBetween(reply.text, 1, 1000)
             && reply.createdAt is int
             && reply.likes == 0
             && reply.kind == 'user';
    }

    function validReplyAppend() {
      let before = resource.data.replies;
      let after = request.resource.data.replies;
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());
      let candidate = after[after.size() - 1];
      return before is list
             && after is list
             && after.size() == before.size() + 1
             && after.size() <= 100
             && removed.size() == 0
             && added.size() == 1
             && added.hasOnly([candidate])
             && validReply(candidate);
    }

    function validPostInteraction() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() == 0 || (
        changed.size() == 1
        && changed.hasOnly(['likedBy'])
        && validLikeToggle()
      ) || (
        changed.size() == 1
        && changed.hasOnly(['replies'])
        && validReplyAppend()
      );
    }

    function validStoryShape(data) {
      return data.keys().hasAll([
               'author', 'authorUid', 'text', 'accent', 'createdAt', 'seen', 'kind'
             ])
             && data.keys().hasOnly([
               'author', 'authorUid', 'text', 'accent', 'createdAt', 'seen',
               'kind', 'placeLabel', 'lng', 'lat', 'photo'
             ])
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && hasTextOrPhoto(data, 500)
             && data.accent in ['sun', 'leaf', 'sea', 'dusk']
             && data.createdAt is timestamp
             && data.seen == false
             && data.kind == 'user'
             && (!('placeLabel' in data) || stringBetween(data.placeLabel, 1, 200))
             && hasValidOptionalLocation(data)
             && hasValidOptionalPhoto(data);
    }

    match /users/{uid} {
      allow get: if true;
      allow list: if false;
      allow create: if ownedBy(uid)
                    && validProfileShape(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.xp == 0
                    && request.resource.data.level == 1
                    && request.resource.data.badges.size() == 0
                    && request.resource.data.following.size() == 0
                    && request.resource.data.followers.size() == 0;
      allow update: if ownedBy(uid)
                    && validProfileShape(request.resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'bio', 'photoURL', 'following'])
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.xp == resource.data.xp
                    && request.resource.data.level == resource.data.level
                    && request.resource.data.badges == resource.data.badges
                    && request.resource.data.followers == resource.data.followers;
      allow delete: if false;
    }

    match /places/{placeId} {
      allow get: if true;
      allow list: if boundedList(250);
      allow create: if signedIn()
                    && validPlaceShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
                    && resource.data.authorUid == request.auth.uid
                    && validPlaceShape(request.resource.data)
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.kind == resource.data.kind
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    match /posts/{postId} {
      allow get: if true;
      allow list: if boundedList(100);
      allow create: if signedIn()
                    && validPostShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.likes == 0
                    && request.resource.data.likedBy.size() == 0
                    && request.resource.data.replies.size() == 0;
      allow update: if signedIn() && validPostInteraction();
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    match /stories/{storyId} {
      allow get: if true;
      allow list: if boundedList(100);
      allow create: if signedIn()
                    && validStoryShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
