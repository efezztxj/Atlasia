rules_version = '2';

// Atlasia — Firestore güvenlik kuralları
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function boundedList(maxItems) {
      return request.query.limit != null && request.query.limit <= maxItems;
    }

    function stringBetween(value, minSize, maxSize) {
      return value is string
             && value.size() >= minSize
             && value.size() <= maxSize;
    }

    function hasValidPhoto(data) {
      return ('photo' in data)
             && data.photo is string
             && data.photo.size() <= 180000
             && data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }

    function hasValidOptionalPhoto(data) {
      return !('photo' in data) || hasValidPhoto(data);
    }

    function hasTextOrPhoto(data, maxTextSize) {
      return data.text is string
             && data.text.size() <= maxTextSize
             && (data.text.size() > 0 || hasValidPhoto(data));
    }

    function hasValidOptionalLocation(data) {
      return (
        !('lng' in data)
        && !('lat' in data)
      ) || (
        ('lng' in data)
        && ('lat' in data)
        && data.lng is number
        && data.lng >= -180
        && data.lng <= 180
        && data.lat is number
        && data.lat >= -90
        && data.lat <= 90
      );
    }

    function validPlaceShape(data) {
      return data.keys().hasAll([
               'title', 'region', 'category', 'lng', 'lat', 'note',
               'author', 'authorUid', 'kind', 'createdAt'
             ])
             && data.keys().hasOnly([
               'title', 'region', 'category', 'lng', 'lat', 'note',
               'author', 'authorUid', 'kind', 'createdAt', 'photo'
             ])
             && stringBetween(data.title, 1, 200)
             && stringBetween(data.region, 0, 200)
             && data.category in [
               'cities', 'beaches', 'history', 'nature', 'camp', 'food',
               'photo', 'routes', 'community', 'issues'
             ]
             && data.lng is number
             && data.lng >= -180
             && data.lng <= 180
             && data.lat is number
             && data.lat >= -90
             && data.lat <= 90
             && stringBetween(data.note, 0, 5000)
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && data.kind == 'user'
             && data.createdAt is timestamp
             && hasValidOptionalPhoto(data);
    }

    function validPostShape(data) {
      return data.keys().hasAll([
               'author', 'authorUid', 'text', 'createdAt', 'likes',
               'likedBy', 'kind'
             ])
             && data.keys().hasOnly([
               'author', 'authorUid', 'text', 'createdAt', 'likes',
               'likedBy', 'kind', 'placeLabel', 'lng', 'lat', 'photo'
             ])
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && hasTextOrPhoto(data, 5000)
             && data.createdAt is timestamp
             && data.likes is int
             && data.likes >= 0
             && data.likedBy is list
             && data.likedBy.size() <= 500
             && data.likedBy.toSet().size() == data.likedBy.size()
             && data.kind == 'user'
             && (!('placeLabel' in data) || stringBetween(data.placeLabel, 1, 200))
             && hasValidOptionalLocation(data)
             && hasValidOptionalPhoto(data);
    }

    function validLikeToggle() {
      let before = resource.data.likedBy;
      let after = request.resource.data.likedBy;
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());
      return before is list
             && after is list
             && after.size() <= 500
             && after.toSet().size() == after.size()
             && (
               (
                 after.size() == before.size() + 1
                 && added.size() == 1
                 && added.hasOnly([request.auth.uid])
                 && removed.size() == 0
               ) || (
                 after.size() == before.size() - 1
                 && removed.size() == 1
                 && removed.hasOnly([request.auth.uid])
                 && added.size() == 0
               )
             );
    }

    function validReplyShape(data) {
      return data.keys().hasAll([
               'author', 'authorUid', 'text', 'createdAt', 'kind'
             ])
             && data.keys().hasOnly([
               'author', 'authorUid', 'text', 'createdAt', 'kind'
             ])
             && stringBetween(data.author, 1, 100)
             && data.authorUid == request.auth.uid
             && stringBetween(data.text, 1, 1000)
             && data.createdAt == request.time
             && data.kind == 'user';
    }

    function validPostInteraction() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() == 0 || (
        changed.size() == 1
        && changed.hasOnly(['likedBy'])
        && validLikeToggle()
      );
    }

    function validRouteBody(route) {
      return route is map
             && route.keys().hasAll([
               'id', 'routeTitle', 'routeSummary', 'totalDurationHours',
               'totalDistanceKm', 'transport', 'vibe', 'days', 'weatherNote',
               'alternatives', 'createdAt'
             ])
             && route.keys().hasOnly([
               'id', 'routeTitle', 'routeSummary', 'totalDurationHours',
               'totalDistanceKm', 'transport', 'vibe', 'days', 'weatherNote',
               'alternatives', 'dataSources', 'createdAt', 'origin', 'photo', 'region'
             ])
             && stringBetween(route.id, 1, 128)
             && stringBetween(route.routeTitle, 1, 160)
             && stringBetween(route.routeSummary, 0, 5000)
             && route.totalDurationHours is number
             && route.totalDurationHours >= 0
             && route.totalDurationHours <= 1000
             && route.totalDistanceKm is number
             && route.totalDistanceKm >= 0
             && route.totalDistanceKm <= 100000
             && route.transport in ['walking', 'cycling', 'driving', 'transit']
             && stringBetween(route.vibe, 0, 200)
             && route.days is list
             && route.days.size() <= 30
             && route.alternatives is list
             && route.alternatives.size() <= 20
             && (route.weatherNote == null || stringBetween(route.weatherNote, 0, 2000))
             && (!('dataSources' in route) || (route.dataSources is list && route.dataSources.size() <= 20))
             && (!('photo' in route) || (
               route.photo is string
               && route.photo.size() <= 180000
               && route.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
             ))
             && (!('region' in route) || stringBetween(route.region, 0, 120));
    }

    function validRouteDocument(data) {
      return data.keys().hasAll(['authorUid', 'visibility', 'route', 'saveCount', 'createdAt', 'updatedAt'])
             && data.keys().hasOnly(['authorUid', 'visibility', 'route', 'saveCount', 'createdAt', 'updatedAt'])
             && stringBetween(data.authorUid, 1, 128)
             && data.visibility in ['private', 'unlisted', 'public']
             && validRouteBody(data.route)
             && data.saveCount is int
             && data.saveCount >= 0
             && data.createdAt is timestamp
             && data.updatedAt is timestamp;
    }

    function routeCounterChange(routeId) {
      let savedPath = /databases/$(database)/documents/users/$(request.auth.uid)/savedRoutes/$(routeId);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let addedSavedRoute = !exists(savedPath) && existsAfter(savedPath);
      let removedSavedRoute = exists(savedPath) && !existsAfter(savedPath);
      return signedIn()
             && changed.hasOnly(['saveCount', 'updatedAt'])
             && request.resource.data.updatedAt == request.time
             && (
               (addedSavedRoute
                && request.resource.data.saveCount == resource.data.saveCount + 1)
               || (removedSavedRoute
                   && resource.data.saveCount > 0
                   && request.resource.data.saveCount == resource.data.saveCount - 1)
             );
    }

    function savedRouteCounterIncreased(routeId) {
      let routePath = /databases/$(database)/documents/routes/$(routeId);
      return exists(routePath)
             && getAfter(routePath).data.saveCount == get(routePath).data.saveCount + 1;
    }

    function savedRouteCounterDecreased(routeId) {
      let routePath = /databases/$(database)/documents/routes/$(routeId);
      return !existsAfter(routePath)
             || (exists(routePath)
                 && get(routePath).data.saveCount == getAfter(routePath).data.saveCount + 1);
    }

    function validTrackDocument(data) {
      return data.keys().hasAll([
               'id', 'authorUid', 'startedAt', 'endedAt', 'distanceKm',
               'polyline', 'stops', 'accuracy', 'createdAt'
             ])
             && data.keys().hasOnly([
               'id', 'authorUid', 'startedAt', 'endedAt', 'distanceKm',
               'polyline', 'stops', 'accuracy', 'createdAt'
             ])
             && stringBetween(data.id, 1, 128)
             && stringBetween(data.authorUid, 1, 128)
             && data.startedAt is int
             && data.endedAt is int
             && data.endedAt >= data.startedAt
             && data.distanceKm is number
             && data.distanceKm >= 0
             && data.distanceKm <= 100000
             && data.polyline is string
             && data.polyline.size() <= 250000
             && data.stops is list
             && data.stops.size() <= 100
             && data.accuracy is map
             && data.accuracy.keys().hasOnly(['sampleCount', 'meanMeters', 'maxMeters'])
             && data.accuracy.sampleCount is int
             && data.accuracy.sampleCount >= 0
             && data.accuracy.meanMeters is number
             && data.accuracy.meanMeters >= 0
             && data.accuracy.maxMeters is number
             && data.accuracy.maxMeters >= data.accuracy.meanMeters
             && data.createdAt is timestamp;
    }

    function validStoryShape(data) {
      return data.keys().hasAll([
               'author', 'authorUid', 'text', 'accent', 'createdAt', 'kind'
             ])
             && data.keys().hasOnly([
               'author', 'authorUid', 'text', 'accent', 'createdAt',
               'kind', 'placeLabel', 'lng', 'lat', 'photo'
             ])
             && stringBetween(data.author, 1, 100)
             && stringBetween(data.authorUid, 1, 128)
             && hasTextOrPhoto(data, 500)
             && data.accent in ['sun', 'leaf', 'sea', 'dusk']
             && data.createdAt is timestamp
             && data.kind == 'user'
             && (!('placeLabel' in data) || stringBetween(data.placeLabel, 1, 200))
             && hasValidOptionalLocation(data)
             && hasValidOptionalPhoto(data);
    }

    function validReport(data) {
      return data.keys().hasAll(['reporterUid', 'targetType', 'targetId', 'reason', 'createdAt'])
             && data.keys().hasOnly(['reporterUid', 'targetType', 'targetId', 'targetOwnerUid', 'reason', 'details', 'createdAt'])
             && stringBetween(data.reporterUid, 1, 128)
             && data.reporterUid == request.auth.uid
             && data.targetType in ['place', 'post', 'story', 'user']
             && stringBetween(data.targetId, 1, 200)
             && (!('targetOwnerUid' in data) || stringBetween(data.targetOwnerUid, 1, 128))
             && data.reason in ['spam', 'harassment', 'hate', 'misinfo', 'privacy', 'other']
             && (!('details' in data) || stringBetween(data.details, 1, 1000))
             && data.createdAt == request.time;
    }

    function validBlock(data) {
      return data.keys().hasAll(['blockerUid', 'blockedUid', 'createdAt'])
             && data.keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt'])
             && stringBetween(data.blockerUid, 1, 128)
             && stringBetween(data.blockedUid, 1, 128)
             && data.blockerUid == request.auth.uid
             && data.blockedUid != request.auth.uid
             && data.createdAt == request.time;
    }

    // ─────────────────── Arkadaşlık (açık rıza) yardımcıları ───────────────────
    // pairId deterministiktir: iki UID sıralanır ve '_' ile birleşir. İstemcideki
    // friendshipIdFor() (src/lib/friends.ts) aynı sırayı üretir ve isSafeFriendUid()
    // UID'lerin ASCII + ayracsız olmasını zorunlu kılar; aksi hâlde istemcideki '<'
    // (UTF-16) ile buradaki '<' (kod noktası) farklı sıra verebilirdi.
    function friendshipPathFor(a, b) {
      return /databases/$(database)/documents/friendships/$(a < b ? a + '_' + b : b + '_' + a);
    }

    // İki kullanıcı arasında karşılıklı KABUL EDİLMİŞ arkadaşlık var mı?
    // getAfter kullanılır ki kabul yazımıyla aynı batch'teki grup kendini-ekleme
    // yazımı doğru değerlendirilsin. exists() ön koşulu null .data erişimini önler.
    function isAcceptedFriendWith(a, b) {
      return a != b
             && exists(friendshipPathFor(a, b))
             && getAfter(friendshipPathFor(a, b)).data.status == 'accepted'
             && a in getAfter(friendshipPathFor(a, b)).data.participants
             && b in getAfter(friendshipPathFor(a, b)).data.participants;
    }

    // blockerUid, blockedUid'i engellemiş mi? blocks/{blocker}_{blocked} biçimi
    // moderation.ts içindeki blockIdFor() ile aynıdır.
    function hasBlocked(blockerUid, blockedUid) {
      return exists(/databases/$(database)/documents/blocks/$(blockerUid + '_' + blockedUid));
    }

    function sortedPairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function validFriendshipShape(data) {
      return data.keys().hasAll([
               'requesterUid', 'recipientUid', 'participants', 'status',
               'requesterName', 'recipientName', 'createdAt', 'updatedAt'
             ])
             && data.keys().hasOnly([
               'requesterUid', 'recipientUid', 'participants', 'status',
               'requesterName', 'recipientName', 'createdAt', 'updatedAt', 'acceptedAt'
             ])
             && stringBetween(data.requesterUid, 1, 128)
             && stringBetween(data.recipientUid, 1, 128)
             && data.requesterUid != data.recipientUid
             && data.participants is list
             && data.participants.size() == 2
             && data.participants[0] < data.participants[1]
             && data.participants[0] == (data.requesterUid < data.recipientUid ? data.requesterUid : data.recipientUid)
             && data.participants[1] == (data.requesterUid < data.recipientUid ? data.recipientUid : data.requesterUid)
             && data.status in ['pending', 'accepted', 'declined']
             && stringBetween(data.requesterName, 1, 40)
             && stringBetween(data.recipientName, 0, 40)
             && data.createdAt is timestamp
             && data.updatedAt == request.time
             && (!('acceptedAt' in data) || data.acceptedAt is timestamp);
    }

    function validFriendshipMirror(data, pairId) {
      return data.keys().hasAll(['pairId', 'otherUid', 'otherName', 'direction', 'status', 'createdAt', 'updatedAt'])
             && data.keys().hasOnly(['pairId', 'otherUid', 'otherName', 'direction', 'status', 'createdAt', 'updatedAt'])
             && data.pairId == pairId
             && stringBetween(data.otherUid, 1, 128)
             && stringBetween(data.otherName, 0, 40)
             && data.direction in ['outgoing', 'incoming']
             && data.status in ['pending', 'accepted', 'declined']
             && data.createdAt is timestamp
             && data.updatedAt == request.time;
    }

    function validVerification(data) {
      return data.keys().hasAll(['placeId', 'uid', 'status', 'createdAt'])
             && data.keys().hasOnly(['placeId', 'uid', 'status', 'createdAt', 'note'])
             && stringBetween(data.placeId, 1, 200)
             && stringBetween(data.uid, 1, 128)
             && data.uid == request.auth.uid
             && data.status in ['still_open', 'fee_changed', 'road_closed', 'free_entry', 'closed']
             && (!('note' in data) || stringBetween(data.note, 1, 280))
             && data.createdAt == request.time;
    }

    function validGroupShape(data) {
      return data.keys().hasAll(['name', 'ownerUid', 'memberUids', 'createdAt', 'updatedAt'])
             && data.keys().hasOnly(['name', 'ownerUid', 'memberUids', 'createdAt', 'updatedAt', 'lastMessage'])
             && stringBetween(data.name, 1, 80)
             && stringBetween(data.ownerUid, 1, 128)
             && data.ownerUid == request.auth.uid
             && data.memberUids is list
             && data.memberUids.size() >= 1
             && data.memberUids.size() <= 20
             && data.memberUids.toSet().size() == data.memberUids.size()
             && request.auth.uid in data.memberUids
             && data.createdAt is timestamp
             && data.updatedAt == request.time
             && (!('lastMessage' in data) || validLastMessage(data.lastMessage));
    }

    function validLastMessage(message) {
      return message is map
             && message.keys().hasAll(['text', 'senderUid', 'senderName', 'createdAt'])
             && message.keys().hasOnly(['text', 'senderUid', 'senderName', 'createdAt'])
             && stringBetween(message.text, 1, 200)
             && message.senderUid == request.auth.uid
             && stringBetween(message.senderName, 1, 100)
             && message.createdAt == request.time;
    }

    function validGroupMessage(data) {
      return data.keys().hasAll(['senderUid', 'senderName', 'text', 'createdAt'])
             && data.keys().hasOnly(['senderUid', 'senderName', 'text', 'createdAt'])
             && data.senderUid == request.auth.uid
             && stringBetween(data.senderName, 1, 100)
             && stringBetween(data.text, 1, 1000)
             && data.createdAt == request.time;
    }

    function validGroupIndex(data, groupId) {
      return data.keys().hasAll(['groupId', 'name', 'role', 'joinedAt'])
             && data.keys().hasOnly(['groupId', 'name', 'role', 'joinedAt'])
             && data.groupId == groupId
             && stringBetween(data.name, 1, 80)
             && data.role in ['owner', 'member']
             && data.joinedAt == request.time;
    }

    function validNotification(data) {
      return data.keys().hasAll(['recipientUid', 'actorUid', 'type', 'title', 'body', 'read', 'createdAt'])
             && data.keys().hasOnly(['recipientUid', 'actorUid', 'type', 'title', 'body', 'read', 'createdAt', 'targetId'])
             && stringBetween(data.recipientUid, 1, 128)
             && stringBetween(data.actorUid, 1, 128)
             && data.actorUid == request.auth.uid
             && data.type in ['report_received', 'report_actioned', 'blocked', 'group_invite', 'group_message', 'friend_request', 'friend_accepted', 'system']
             && stringBetween(data.title, 1, 200)
             && stringBetween(data.body, 0, 500)
             && data.read is bool
             && data.read == false
             && data.createdAt == request.time
             && (!('targetId' in data) || stringBetween(data.targetId, 1, 200));
    }

    match /places/{placeId} {
      allow get: if true;
      // Toplam içerik tavanı değil: her overview/viewport/sahip cursor sayfası
      // en fazla 50 kayıt okuyabilir; limitsiz ve aşırı büyük istek fail-closed.
      allow list: if boundedList(50);
      allow create: if signedIn()
                    && validPlaceShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
                    && resource.data.authorUid == request.auth.uid
                    && validPlaceShape(request.resource.data)
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.kind == resource.data.kind
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    match /posts/{postId} {
      allow get: if true;
      // Akış cursor sayfaları 50 kayıtla sınırlıdır; eski kayıtlar sonraki sayfalardadır.
      allow list: if boundedList(50);
      allow create: if signedIn()
                    && validPostShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.likes == 0
                    && request.resource.data.likedBy.size() == 0;
      allow update: if signedIn() && validPostInteraction();
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;

      match /replies/{replyId} {
        function parentPostExists() {
          return exists(/databases/$(database)/documents/posts/$(postId));
        }

        allow get: if parentPostExists();
        allow list: if parentPostExists() && boundedList(100);
        allow create: if signedIn()
                      && parentPostExists()
                      && validReplyShape(request.resource.data);
        allow update: if false;
        allow delete: if signedIn()
                      && (resource.data.authorUid == request.auth.uid
                          || (parentPostExists()
                              && get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid));
      }
    }

    match /stories/{storyId} {
      // Kusur #5: "24 saat" yalnız istemcideydi; kurallar süreyi uygulamıyordu ve
      // base64 fotoğraflı eski hikâyeler süresiz herkese açık kalıyordu. Pencere
      // artık kural tarafında da zorunlu. İstemci sorgusu zaten
      // where(createdAt >= now-24h) gönderdiği (firestoreData.ts STORY_TTL_MS)
      // için liste akışı kırılmaz; süresi dolmuş bir hikâyeyi doğrudan id ile
      // ancak sahibi okuyabilir (silme hakkını korumak için).
      function storyLive() {
        return resource.data.createdAt >= request.time - duration.value(24, 'h');
      }
      allow get: if storyLive()
                 || (signedIn() && resource.data.authorUid == request.auth.uid);
      // LİSTEDE 24 SAAT PENCERESİ UYGULANAMIYOR — kanıtlı sınır (CI, 2026-10-22):
      // Firestore list kuralları tek tek belgelere değil, sorgudan türetilen
      // sentetik bir nesneye karşı değerlendiriliyor. Eşitlik filtresi
      // kanıtlanabiliyor (routes: where visibility == 'public' → allow), ama
      // createdAt için aralık filtresi (>= now-24h) kanıtlanamıyor: emülatör
      // "Property createdAt is undefined on object. for 'list' @ L507" hatasıyla
      // reddediyor ve herkese açık hikâye akışı kırılıyordu. Pencereyi burada
      // zorlamak ayrıca istemci saatine bağımlı (cutoff, request.time'dan
      // milisaniyeler önce hesaplanırsa akış kapanır) olurdu. Bu yüzden liste
      // yalnız 50 kayıtla sınırlı kalır; süre zorunluluğu get'te uygulanır ve
      // istemci sorgusu createdAt >= now-24h filtresini zaten sunucuya gönderir
      // (firestoreData.ts STORY_TTL_MS). Kalan 🟡 risk: filtresiz bir liste
      // sorgusu süresi dolmuş kayıtları da döndürebilir; bunu kapatmak için
      // listeyi oturuma bağlamak (ürün kararı) veya TTL/veri modeli değişikliği
      // gerekir — ikisi de ayrı onay konusu.
      allow list: if boundedList(50);
      allow create: if signedIn()
                    && validStoryShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    match /routes/{routeId} {
      // public ve unlisted rotalar bağlantıyla; private yalnız sahip tarafından okunur.
      allow get: if resource.data.visibility in ['public', 'unlisted']
                 || (signedIn() && resource.data.authorUid == request.auth.uid);
      // Keşif sorgusu public görünürlüğü açıkça filtreler; sahip kendi kayıtlarını sorgulayabilir.
      allow list: if boundedList(40)
                  && (resource.data.visibility == 'public'
                      || (signedIn() && resource.data.authorUid == request.auth.uid));
      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.route.id == routeId
                    && request.resource.data.saveCount == 0
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && validRouteDocument(request.resource.data);
      allow update: if signedIn()
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.route.id == routeId
                    && validRouteDocument(request.resource.data)
                    && (
                      (resource.data.authorUid == request.auth.uid
                       && request.resource.data.saveCount == resource.data.saveCount
                       && request.resource.data.updatedAt == request.time)
                      || routeCounterChange(routeId)
                    );
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /tracks/{trackId} {
      allow get: if signedIn() && resource.data.authorUid == request.auth.uid;
      allow list: if signedIn() && resource.data.authorUid == request.auth.uid && boundedList(100);
      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.id == trackId
                    && request.resource.data.createdAt == request.time
                    && validTrackDocument(request.resource.data);
      allow update: if signedIn()
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.id == trackId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && validTrackDocument(request.resource.data);
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /users/{uid}/savedPlaces/{placeId} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if signedIn() && request.auth.uid == uid && boundedList(100);
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['place', 'savedAt'])
                            && request.resource.data.keys().hasAll(['place', 'savedAt'])
                            && request.resource.data.place is map
                            && request.resource.data.place.id == placeId
                            && request.resource.data.savedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/savedRoutes/{routeId} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if signedIn() && request.auth.uid == uid && boundedList(100);
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['routeId', 'savedAt'])
                    && request.resource.data.keys().hasAll(['routeId', 'savedAt'])
                    && request.resource.data.routeId == routeId
                    && request.resource.data.savedAt == request.time
                    && savedRouteCounterIncreased(routeId);
      allow update: if false;
      allow delete: if signedIn()
                    && request.auth.uid == uid
                    && savedRouteCounterDecreased(routeId);
    }

    // Tazelik doğrulamaları: herkese açık okuma, yalnız kendi adına yazma.
    // Liste isteği 50 kayıtla sınırlıdır; canlı dinleyici tek pencere tutar.
    match /verifications/{verificationId} {
      allow get: if true;
      allow list: if boundedList(50);
      allow create: if signedIn() && validVerification(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow get: if signedIn() && resource.data.reporterUid == request.auth.uid;
      allow list: if signedIn() && boundedList(50)
                    && resource.data.reporterUid == request.auth.uid;
      allow create: if signedIn() && validReport(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.reporterUid == request.auth.uid;
    }

    match /blocks/{blockId} {
      allow get: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow list: if signedIn() && boundedList(50)
                    && resource.data.blockerUid == request.auth.uid;
      allow create: if signedIn() && validBlock(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
    }

    // ─────────────────────────── Adım 16 · grup + sohbet ───────────────────────────
    // Okuma sınırı: grup listesi kullanıcının kendi indeksinden (limit 20), mesajlar
    // tek grupta en yeni 50 kayıttan okunur. Realtime Database veya üçüncü taraf yok.
    match /groups/{groupId} {
      // Daveti KABUL eden üye olmayan kullanıcı YALNIZ kendini ekleyebilir ve
      // kurucuyla kabul edilmiş arkadaşlığı olduğunu kanıtlamak zorundadır.
      // Başkasını ekleyemez, adı/sahibi/kod alanlarına dokunamaz. Böylece
      // "kabul edilmiş arkadaşlık veya davet olmadan doğrudan ekleme" kapanır.
      function friendInviteSelfAdd() {
        return !(request.auth.uid in resource.data.memberUids)
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
               && request.resource.data.name == resource.data.name
               && request.resource.data.ownerUid == resource.data.ownerUid
               && request.resource.data.createdAt == resource.data.createdAt
               && request.resource.data.updatedAt == request.time
               && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
               && request.resource.data.memberUids.size() >= 1
               && request.resource.data.memberUids.size() <= 20
               && isAcceptedFriendWith(request.auth.uid, resource.data.ownerUid);
      }

      allow get: if signedIn() && request.auth.uid in resource.data.memberUids;
      // Geniş koleksiyon taraması kapalı: kullanıcı yalnız üyesi olduğu grubu tek
      // belge olarak okur; liste kendi users/{uid}/groups indeksinden gelir.
      allow list: if false;
      allow create: if signedIn() && validGroupShape(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    // RIZA (kusur #4): kuruluş anında üye listesi YALNIZ kurucuyu
                    // içerebilir. Başkasını doğrudan eklemek kapalıdır; diğerleri
                    // ancak group_invite + kabul ile (friendInviteSelfAdd) katılır.
                    // validGroupShape zaten auth.uid in memberUids ve size>=1 der,
                    // hasOnly ile liste tam olarak [kurucu] olur.
                    && request.resource.data.memberUids.hasOnly([request.auth.uid]);
      allow update: if signedIn()
                    && (
                      (
                        // Üyeler: grup düzenleme, son mesaj ve kendi kendine ayrılma.
                        request.auth.uid in resource.data.memberUids
                        && (
                          (
                            resource.data.ownerUid == request.auth.uid
                            && validGroupShape(request.resource.data)
                            && request.resource.data.ownerUid == resource.data.ownerUid
                            && request.resource.data.createdAt == resource.data.createdAt
                          ) || (
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
                            && validLastMessage(request.resource.data.lastMessage)
                            && request.resource.data.name == resource.data.name
                            && request.resource.data.ownerUid == resource.data.ownerUid
                            && request.resource.data.memberUids == resource.data.memberUids
                            // Kusur #1: updatedAt daha önce doğrulanmıyordu; hasOnly
                            // değeri kısıtlamaz, yalnız alana izin verir. İstemci
                            // (sendGroupMessage) updatedAt gönderir, bu şart akışı kırmaz.
                            && request.resource.data.updatedAt == request.time
                          ) || (
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                            && request.resource.data.name == resource.data.name
                            && request.resource.data.ownerUid == resource.data.ownerUid
                            && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
                            // Kusur #1 (aynı neden): kendini-çıkarma dalı da updatedAt'i
                            // serbest bırakıyordu. İstemci (leaveGroup) updatedAt gönderir.
                            && request.resource.data.updatedAt == request.time
                          )
                        )
                      )
                      // Üye olmayan: yalnız kabul edilmiş arkadaş davetiyle kendini ekler.
                      || friendInviteSelfAdd()
                    );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /messages/{messageId} {
        // Kusur #3: grup silinmişse get(...).data null olur ve kural değerlendirme
        // hatasına düşüp permission-denied üretirdi. exists guard'ı ile silinmiş
        // grup için üyelik listesi boş döner; istek temiz biçimde reddedilir.
        function groupMembers() {
          return exists(/databases/$(database)/documents/groups/$(groupId))
                 ? get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                 : [];
        }
        allow get: if signedIn() && request.auth.uid in groupMembers();
        allow list: if signedIn() && boundedList(50) && request.auth.uid in groupMembers();
        allow create: if signedIn()
                      && request.auth.uid in groupMembers()
                      && validGroupMessage(request.resource.data);
        allow update: if false;
        allow delete: if signedIn() && resource.data.senderUid == request.auth.uid;
      }
    }

    // Kullanıcının kendi grup indeksi: listeleme buradan yapılır (limit 20).
    match /users/{uid}/groups/{groupId} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if signedIn() && uid == request.auth.uid && boundedList(20);
      allow create: if signedIn() && uid == request.auth.uid
                    && validGroupIndex(request.resource.data, groupId)
                    // Kusur #2: indeks daha önce üyelik kanıtı istemiyordu; kullanıcı
                    // kendi indeksine üye/sahibi olmadığı bir grup için sahte rol
                    // yazabiliyordu. İndeks ancak GERÇEK üyeliği yansıtabilir ve rol
                    // grup belgesindeki sahiplikle birebir tutarlı olmalıdır.
                    // createGroup ve acceptGroupInvite indeksi grup yazıldıktan SONRA
                    // (sıralı) yazar, bu yüzden get() burada güvenlidir.
                    && exists(/databases/$(database)/documents/groups/$(groupId))
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                    && (request.resource.data.role == 'owner')
                       == (get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid);
      allow update: if false;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // Notifications: kullanıcı subcollection — yalnız alıcı okur, aktör yazar (engelleme hariç)
    match /users/{uid}/notifications/{notificationId} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if signedIn() && uid == request.auth.uid && boundedList(50);
      allow create: if signedIn() && validNotification(request.resource.data) && request.resource.data.recipientUid == uid;
      allow update: if signedIn() && uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read is bool;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // Blocks subcollection (alternatif yol) — üstteki top-level ile aynı, uyumluluk için
    match /users/{uid}/blocks/{blockedId} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if signedIn() && uid == request.auth.uid && boundedList(50);
      allow create: if signedIn() && uid == request.auth.uid && request.resource.data.blockerUid == uid && request.resource.data.blockedUid == blockedId && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // ─────────────────────── Arkadaşlık · açık rıza ───────────────────────
    // Yetkili rıza kaydı. Yalnız iki taraf okur; koleksiyon taraması KAPALIDIR,
    // böylece kimlik enumeration'ı ve dizin harmanı mümkün değildir. Görünen ad
    // yalnız burada ve own-scoped aynada durur; telefon/e-posta hiçbir alanda yok.
    match /friendships/{pairId} {
      allow get: if signedIn() && request.auth.uid in resource.data.participants;
      allow list: if false;
      allow create: if signedIn()
                    // Yalnız isteyen taraf, yalnız kendisi adına isteyebilir.
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.recipientUid != request.auth.uid
                    // Belge kimliği deterministik sıralı çift olmalı; aksi hâlde
                    // aynı ilişki için iki ayrı belge açılıp rıza atlanabilirdi.
                    && pairId == sortedPairId(request.resource.data.requesterUid, request.resource.data.recipientUid)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    && validFriendshipShape(request.resource.data)
                    // Engelleme iki yönde de istek üretmeyi keser.
                    && !hasBlocked(request.resource.data.recipientUid, request.resource.data.requesterUid)
                    && !hasBlocked(request.resource.data.requesterUid, request.resource.data.recipientUid);
      allow update: if signedIn()
                    // Rızayı YALNIZ alıcı verebilir; isteyen kendi isteğini kabul edemez.
                    && resource.data.recipientUid == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['accepted', 'declined']
                    // Kimlik, taraf listesi ve oluşturma anı değiştirilemez.
                    && request.resource.data.requesterUid == resource.data.requesterUid
                    && request.resource.data.recipientUid == resource.data.recipientUid
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.requesterName == resource.data.requesterName
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'recipientName', 'acceptedAt', 'updatedAt'])
                    && (
                      request.resource.data.status == 'declined'
                      || (
                        stringBetween(request.resource.data.recipientName, 1, 40)
                        && request.resource.data.acceptedAt == request.time
                        // Kabul anında engelleme varsa rıza geçerli değildir.
                        && !hasBlocked(resource.data.requesterUid, resource.data.recipientUid)
                        && !hasBlocked(resource.data.recipientUid, resource.data.requesterUid)
                      )
                    );
      // Geri çekme veya arkadaşlıktan çıkma: iki taraftan biri silebilir.
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    // Ayna kayıt: UI'ın tek doğruluk kaynağı (gönderilen/alınan istekler + kabul
    // edilmiş arkadaşlar). Liste own-scoped ve 50 kayıtla sınırlı; composite index
    // gerektirmez. Grup seçim listesi status == 'accepted' kayıtlarından gelir.
    match /users/{uid}/friendships/{pairId} {
      function friendshipAfter() {
        return getAfter(/databases/$(database)/documents/friendships/$(pairId)).data;
      }

      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if signedIn() && uid == request.auth.uid && boundedList(50);
      allow create: if signedIn()
                    && request.resource.data.pairId == pairId
                    && validFriendshipMirror(request.resource.data, pairId)
                    // Karşı tarafın aynasını yazabilmek için rıza kaydı VAR olmalı
                    // ve hem yazan hem ayna sahibi onun tarafı olmalı. existsAfter
                    // ön koşulu null .data erişimini engeller.
                    && existsAfter(/databases/$(database)/documents/friendships/$(pairId))
                    && request.auth.uid in friendshipAfter().participants
                    && uid in friendshipAfter().participants
                    && request.resource.data.status == friendshipAfter().status
                    // Ayna kimliği rıza kaydıyla tutarlı olmalı: diğer taraf ve yön.
                    && request.resource.data.otherUid == (
                         friendshipAfter().requesterUid == uid
                         ? friendshipAfter().recipientUid
                         : friendshipAfter().requesterUid)
                    && request.resource.data.direction == (
                         friendshipAfter().requesterUid == uid ? 'outgoing' : 'incoming')
                    && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
                    // Ayna sahibi ya da karşı taraf güncelleyebilir ama yalnız rıza
                    // kaydının gerçek durumuna eşitleyebilir; ayna rızanın önüne geçemez.
                    && existsAfter(/databases/$(database)/documents/friendships/$(pairId))
                    && request.auth.uid in friendshipAfter().participants
                    && uid in friendshipAfter().participants
                    && request.resource.data.pairId == pairId
                    && request.resource.data.otherUid == resource.data.otherUid
                    && request.resource.data.direction == resource.data.direction
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.status == friendshipAfter().status
                    && stringBetween(request.resource.data.otherName, 0, 40)
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'otherName', 'updatedAt']);
      // Kendi aynasını her zaman silebilir; rıza kaydı kalktıysa karşı taraf da
      // temizleyebilir (arkadaşlıktan çıkma tek batch'te iki aynayı kaldırır).
      allow delete: if signedIn()
                    && (uid == request.auth.uid
                        || !existsAfter(/databases/$(database)/documents/friendships/$(pairId)));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
