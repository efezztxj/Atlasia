{
  "name": "atlasia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/verify-env.mjs",
    "build": "vite build",
    "postbuild": "node scripts/collect-sourcemaps.mjs && npm run bundle:budget && npm run verify:sw-shell",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "verify:sw-shell": "node scripts/verify-sw-shell.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:owner-index": "node --test scripts/ensure-owner-places-index.node-test.mjs",
    "test:bundle-budget": "node --test scripts/bundle-budget.node-test.mjs",
    "test:verify-env": "node --test scripts/verify-env.node-test.mjs",
    "test:content": "node --test scripts/content/harvest.node-test.mjs",
    "test:sw": "node --test scripts/sw.node-test.mjs",
    "test:rules-inventory": "node --test scripts/rules-inventory.node-test.mjs",
    "test:social": "node --test scripts/publish-instagram.node-test.mjs",
    "test:telemetry-worker": "node --test workers/telemetry/worker.node-test.mjs",
    "test:backup": "node --test scripts/firestore-backup.node-test.mjs",
    "test:cleanup": "node --test scripts/firestore-cleanup.node-test.mjs",
    "test:restore": "node --test scripts/firestore-restore.node-test.mjs",
    "test:scripts": "npm run test:owner-index && npm run test:bundle-budget && npm run test:verify-env && npm run test:canli && npm run test:content && npm run test:sw && npm run test:rules-inventory && npm run test:social && npm run test:telemetry-worker && npm run test:backup && npm run test:cleanup && npm run test:restore",
    "backup:firestore": "node scripts/firestore-backup.mjs",
    "restore:firestore": "node scripts/firestore-restore.mjs",
    "test:e2e": "playwright test",
    "test:e2e:canli": "playwright test --config playwright.canli.config.ts",
    "test:lighthouse": "lhci autorun",
    "test:canli": "node --test scripts/canli-yapilandirma.node-test.mjs",
    "dogrula:canli": "node scripts/canli-yapilandirma.mjs",
    "rules:inventory": "node scripts/rules-inventory.mjs",
    "ensure:owner-places-index": "node scripts/ensure-owner-places-index.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run test:scripts && npm run test:rules:emulator && npm run build && npm run verify:social-metadata && npm run audit:check",
    "verify:social-metadata": "node scripts/verify-social-metadata.mjs",
    "mobil:onizleme": "node scripts/mobil-onizleme.mjs",
    "audit:prod": "npm audit --omit=dev",
    "audit:check": "node scripts/audit-baseline.mjs",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:rules:emulator": "node scripts/run-firestore-rules-tests.mjs",
    "social:publish": "node scripts/publish-instagram.mjs",
    "test:cov": "vitest run --coverage",
    "state:doc": "node scripts/state-doc.mjs"
  },
  "dependencies": {
    "@types/tz-lookup": "^6.1.2",
    "clsx": "2.1.1",
    "fflate": "^0.8.3",
    "firebase": "^13.2.0",
    "lucide-react": "^1.66.0",
    "maplibre-gl": "6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^2.1.1",
    "tailwind-merge": "3.7.0",
    "tz-lookup": "^6.1.25"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "description": "Atlasia keşif haritası ve konum tabanlı web/PWA uygulaması",
  "packageManager": "npm@10.9.2"
}
