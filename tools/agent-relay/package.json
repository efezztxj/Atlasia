{
  "name": "@atlasia/agent-relay",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Tek yerden yaz, ekibin sırayla çalışsın: kuyruk + devir teslim + onay paneli.",
  "bin": {
    "agent-relay": "./bin/relay.mjs"
  },
  "scripts": {
    "start": "node bin/relay.mjs up",
    "dev": "node --watch server.mjs",
    "send": "node bin/relay.mjs send",
    "status": "node bin/relay.mjs status",
    "build": "node scripts/build.mjs all",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "relay.config.json"
    ]
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.6.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
