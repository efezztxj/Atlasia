# A5: HSTS'ye includeSubDomains eklendi. `preload` BİLİNÇLİ OLARAK YOK: preload
# listesine girmek alan adının kökünde (apex) başvuru ve uzun süre geri dönüşsüzlük
# ister; burada kök alan Cloudflare'in (pages.dev), bizim alanımız yalnız bir alt
# alan. Koşullar sağlanınca (özel alan adı) tek satırlık ekleme yeterli.
# Cloudflare Pages parses this file at deploy time. Keep every header line under 2,000 characters.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://www.recaptcha.net/recaptcha/; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://commons.wikimedia.org https://upload.wikimedia.org https://*.arcgisonline.com https://tiles.openfreemap.org https://s3.amazonaws.com https://*.openstreetmap.org https://www.google.com https://www.gstatic.com; connect-src 'self' https://apis.google.com https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://*.web.app https://accounts.google.com https://appleid.apple.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://recaptcha.google.com https://server.arcgisonline.com https://tiles.openfreemap.org https://s3.amazonaws.com https://photon.komoot.io https://api.open-meteo.com https://geocoding-api.open-meteo.com https://commons.wikimedia.org https://api.pwnedpasswords.com https://overpass-api.de https://tr.wikipedia.org https://en.wikipedia.org https://www.wikidata.org; frame-src 'self' https://apis.google.com https://*.firebaseapp.com https://*.web.app https://accounts.google.com https://appleid.apple.com https://www.google.com https://www.recaptcha.net https://recaptcha.google.com https://www.openstreetmap.org; worker-src 'self' blob:; media-src 'self' data: blob:; manifest-src 'self'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), browsing-topics=(), camera=(), clipboard-write=(self), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  X-XSS-Protection: 0

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/theme-boot.js
  Cache-Control: no-cache, must-revalidate

# B2: self-host fontlar içerik adresli değil; kısa ömür + yeniden doğrulama yeterli.
/fonts/*.woff2
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/fonts/fonts.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Preview deployments must not compete with the production URL in search results.
https://:version.atlasia.pages.dev/*
  X-Robots-Tag: noindex, nofollow
